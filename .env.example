# LLM provider: auto|fake|claude|azure
PROVIDER=auto
CLAUDE_CODE_OAUTH_TOKEN=
MODEL_STRONG=claude-opus-5-5
MODEL_STANDARD=claude-sonnet-5-5
MODEL_EFFICIENT=claude-haiku-4-5
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_STRONG=
AZURE_OPENAI_DEPLOYMENT_STANDARD=
AZURE_OPENAI_DEPLOYMENT_EFFICIENT=

# Dev ports. The Makefile and the web both read these two keys (web/scripts/root-env.ts), so the
# web always calls the API the Makefile starts. Move the API by changing API_PORT here only.
API_PORT=9000
WEB_PORT=3000

# Database
DATABASE_URL=postgresql+asyncpg://exiqo:exiqo@localhost:5432/exiqo
TEST_DATABASE_URL=postgresql://exiqo:exiqo@localhost:5432/exiqo_test

# Storage and secrets
DATA_DIR=./data
# Fernet key for stored Azure credentials
APP_SECRET=

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Build toolchain. false skips dotnet restore, build, format and test, and with them the
# compile repair loop: the solution is still generated, filled, reviewed and stored, and those
# steps report "not run" with that reason. For iterating on the generator or the screens
# without paying for a repair loop every run. G4 still refuses a build that was never compiled.
BUILD_TOOLCHAIN=true

# Install (GM Financial AKS). Defaults keep local development: one process, dev personas.
# Any secret below can instead be read from a mounted file with <NAME>_FILE=/path.
EXIQO_ROLE=all
AUTH_MODE=dev
DEPLOY_CREDENTIAL_MODE=local
API_BASE_PATH=
INTERNAL_TOKEN=
INTERNAL_PORT=9100
WORKER_HOST=
JOB_STALE_SECONDS=90
JOB_HEARTBEAT_SECONDS=10
JOB_MAX_ATTEMPTS=2
# Leave NEO4J_URI empty to run without Neo4j; with `docker compose up neo4j` use bolt://localhost:7687
# and the same NEO4J_PASSWORD (compose default: exiqo-dev-neo4j).
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
BRAND_NAME=ExiQO
SUPPORT_CONTACT=
AZURE_OPENAI_AUTH=key
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
SESSION_SECRET=
# JSON: {"engineer":["<entra group id>"]}
# ROLE_GROUPS=
# JSON list: [{"name":"dev","tenant":"","subscription":"","client_id":"","auth":"workload_identity"}]
# DEPLOY_ENVIRONMENTS=
# JSON object name -> digest, JSON list of hosts
# IMAGE_DIGESTS=
# EGRESS_ALLOWLIST=
