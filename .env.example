# LLM provider: auto|fake|claude|azure
PROVIDER=auto
CLAUDE_CODE_OAUTH_TOKEN=
MODEL_STRONG=claude-opus-5-5
MODEL_STANDARD=claude-sonnet-5-5
MODEL_EFFICIENT=claude-haiku-4-5
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_STRONG=
AZURE_OPENAI_DEPLOYMENT_STANDARD=
AZURE_OPENAI_DEPLOYMENT_EFFICIENT=

# Dev ports. The Makefile and the web both read these two keys (web/scripts/root-env.ts), so the
# web always calls the API the Makefile starts. Move the API by changing API_PORT here only.
API_PORT=9000
WEB_PORT=3000

# Database
DATABASE_URL=postgresql+asyncpg://exiqo:exiqo@localhost:5432/exiqo
TEST_DATABASE_URL=postgresql://exiqo:exiqo@localhost:5432/exiqo_test

# Storage and secrets
DATA_DIR=./data
# Fernet key for stored Azure credentials
APP_SECRET=

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Build toolchain. false skips dotnet restore, build, format and test, and with them the
# compile repair loop: the solution is still generated, filled, reviewed and stored, and those
# steps report "not run" with that reason. For iterating on the generator or the screens
# without paying for a repair loop every run. G4 still refuses a build that was never compiled.
BUILD_TOOLCHAIN=true
