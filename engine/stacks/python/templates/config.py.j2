"""Configuration of the service, read from the environment (the runtime contract).

Environment names follow the ASP.NET convention, ``__`` separated; each is read under its canonical
key, every segment in upper snake case: ``Gmf__Dealerfunding__DbUrl`` is ``GMF_DEALERFUNDING_DB_URL``,
``ConnectionStrings__GMFFundingDB`` is ``CONNECTION_STRINGS_GMF_FUNDING_DB`` and ``Cors__Origins__0``
is ``CORS_ORIGINS_0``. A name already in that form is read as it is. ``ASPNETCORE_ENVIRONMENT=Development``
(what ExiQO's Verify sets) selects the development defaults below. When ``KeyVault__Uri`` is set,
every Key Vault secret named with ``--`` (``Gmf--Dealerfunding--DbPassword``) lands on the same key,
read with DefaultAzureCredential (the workload's managed identity), and wins over the environment, as
Key Vault does in the .NET services. Generated by ExiQO Migrate from TIBCO BusinessWorks application
{{ app_id }}.
{% if not_carried %}

TIBCO substitution variables not carried over (nothing in the generated code reads them):
{% for name, reason in not_carried %}
  {{ name }}: {{ reason }}
{% endfor %}
{% endif %}
"""

from __future__ import annotations

import os
import re
from collections.abc import Mapping
from typing import Any

_WORD = re.compile(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|[0-9]+")

# What every environment starts from.
DEFAULTS: dict[str, Any] = {
{% for line in defaults %}
    {{ line }}
{% endfor %}
}

# On top of DEFAULTS with ASPNETCORE_ENVIRONMENT=Development.
DEVELOPMENT: dict[str, Any] = {
{% for line in development %}
    {{ line }}
{% endfor %}
}


def upper_snake(segment: str) -> str:
    """One name segment in upper snake case: ``GMFFundingDB`` is ``GMF_FUNDING_DB``, ``DbUrl`` is ``DB_URL``."""
    words = _WORD.findall(segment)
    return "_".join(w.upper() for w in words) if words else segment.upper()


def canonical(name: str, separator: str = "__") -> str | None:
    """``Cors__Origins__0`` as ``CORS_ORIGINS_0``; None for a name without the separator."""
    parts = name.split(separator)
    if len(parts) < 2 or any(not p for p in parts):
        return None
    return "_".join(upper_snake(p) for p in parts)


def _key_vault(uri: str) -> dict[str, str]:
    from azure.identity import DefaultAzureCredential
    from azure.keyvault.secrets import SecretClient

    client = SecretClient(vault_url=uri, credential=DefaultAzureCredential())
    out: dict[str, str] = {}
    for secret in client.list_properties_of_secrets():
        if secret.enabled is False or not secret.name:
            continue
        key = canonical(secret.name, "--")
        if key is not None:
            out[key] = client.get_secret(secret.name).value or ""
    return out


class Settings:
    """The service's settings by canonical key."""

    def __init__(self, values: Mapping[str, Any], development: bool) -> None:
        self.values = dict(values)
        self.development = development

    @classmethod
    def load(cls, environ: Mapping[str, str] | None = None, key_vault: bool = True) -> Settings:
        """DEFAULTS, then DEVELOPMENT in development, then the environment, then Key Vault."""
        env = os.environ if environ is None else environ
        development = str(env.get("ASPNETCORE_ENVIRONMENT", "")).strip().lower() == "development"
        values: dict[str, Any] = dict(DEFAULTS)
        if development:
            values.update(DEVELOPMENT)
        for name in sorted(env):
            key = canonical(name)
            values[key if key is not None else name] = env[name]
        uri = str(values.get("KEY_VAULT_URI") or "").strip()
        if key_vault and uri:
            values.update(_key_vault(uri))
        return cls(values, development)

    def get(self, key: str, default: Any = None) -> Any:
        return self.values.get(key, default)

    def text(self, key: str, default: str = "") -> str:
        value = self.values.get(key)
        return default if value is None else str(value).strip()

    def flag(self, key: str, default: bool = False) -> bool:
        value = self.values.get(key)
        if value is None or value == "":
            return default
        if isinstance(value, bool):
            return value
        return str(value).strip().lower() in ("1", "true", "yes", "on")

    def integer(self, key: str, default: int) -> int:
        try:
            return int(str(self.values.get(key, default)).strip())
        except ValueError:
            return default

    def items(self, prefix: str) -> list[str]:
        """``PREFIX_0``, ``PREFIX_1``, ... in order (a list setting such as CORS_ORIGINS)."""
        out: list[str] = []
        while f"{prefix}_{len(out)}" in self.values:
            out.append(str(self.values[f"{prefix}_{len(out)}"]))
        return out
