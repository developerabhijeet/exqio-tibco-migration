# syntax=docker/dockerfile:1
# {{ package }}: multi-stage build, Python {{ python }} runtime, non-root. Generated by ExiQO Migrate.
#
# Build arguments. The two base images have NO default, so a build never reaches a public registry
# by accident: pass images from GMF's registry (the pipelines stop when either is empty). Upstream
# equivalent to mirror, for both: {{ base_image }}.
#   BASE_IMAGE_BUILD    the Python image the locked dependencies are installed in
#   BASE_IMAGE_RUNTIME  the Python image the service runs in (the same Python line)
#   PIP_INDEX_URL       GMF's PyPI mirror (.../simple); every file is checked against the hashes
#                       in requirements.lock, so a mirror cannot hand over anything else
ARG BASE_IMAGE_BUILD
ARG BASE_IMAGE_RUNTIME

FROM ${BASE_IMAGE_BUILD} AS build
ARG PIP_INDEX_URL=
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# The dependency layer is cached until the lock changes; nothing is resolved and nothing is built, only
# the locked wheels are installed (--require-hashes --no-deps --only-binary). The runtime lock is the
# full lock's files without the test and format tools.
COPY requirements.runtime.lock /tmp/requirements.lock
RUN if [ -n "${PIP_INDEX_URL}" ]; then export PIP_INDEX_URL; else unset PIP_INDEX_URL; fi \
 && python -m venv /opt/venv \
 && /opt/venv/bin/pip install --require-hashes --no-deps --only-binary=:all: -r /tmp/requirements.lock

FROM ${BASE_IMAGE_RUNTIME} AS runtime
WORKDIR /app

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=UTC \
    PORT=8080
EXPOSE 8080

COPY --from=build /opt/venv /opt/venv
COPY src ./src

# A numeric id lets Kubernetes verify runAsNonRoot; the service writes nothing to disk. TZ=UTC: a
# database timestamp without a zone is read as UTC, as the Java stack reads it in its container.
USER 10001
# Exec form (no shell needed); the module reads PORT.
ENTRYPOINT ["python", "-m", "{{ package }}.main"]
