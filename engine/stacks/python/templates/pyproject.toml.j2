# Generated by ExiQO Migrate from TIBCO BusinessWorks application {{ app_id }}.
# Versions are pinned by ExiQO (engine/stacks/python/versions.py); requirements.lock holds them with
# every hash, and the index is GMF's mirror (UV_INDEX_URL), never this file.
[project]
name = "{{ dist }}"
version = "1.0.0"
description = "{{ app }} service migrated from TIBCO BusinessWorks application {{ app_id }}"
requires-python = ">={{ v.PYTHON }},<{{ next_python }}"
dependencies = [
{% for name, version in v.DEPENDENCIES %}
  "{{ name }}=={{ version }}",
{% endfor %}
]

[dependency-groups]
dev = [
{% for name, version in v.DEV_DEPENDENCIES %}
  "{{ name }}=={{ version }}",
{% endfor %}
]

[tool.ruff]
line-length = 120
target-version = "py{{ v.PYTHON | replace('.', '') }}"
src = ["src", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src", "."]
addopts = "-p no:cacheprovider"
