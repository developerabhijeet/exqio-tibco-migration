# The connection settings the generated service reads; all point at the test database.
CONNECTION_KEYS: tuple[str, ...] = ({% for c in connections %}{{ c | py_string }}, {% endfor %})


def service_settings() -> Settings:
    """The development settings of the service under test."""
    env = dict(os.environ)
    env.update({"ASPNETCORE_ENVIRONMENT": "Development", "AUTH_MODE": "Development", "MESSAGING_MODE": "InMemory",
                "JOBS_ENABLED": "false", "KEY_VAULT_URI": ""})
    url = os.environ.get("TEST_DATABASE_URL", "").strip()
    if url:
        for key in CONNECTION_KEYS:
            env[key] = url
    return Settings.load(env, key_vault=False)


