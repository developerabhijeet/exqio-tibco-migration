"""Connections per TIBCO JDBC resource, from its connection string (CONNECTION_STRINGS_<RESOURCE>,
ConnectionStrings__<Resource> in the environment), on psycopg 3. The string is the runtime contract's
Npgsql form (Host=..;Port=..;Database=..;Username=..;Password=..), a jdbc:postgresql: URL, or a
postgresql:// URL. Every statement runs in autocommit, as a TIBCO JDBC activity without a
transaction group does, on its own connection (no pool: psycopg_pool is not in the locked set)."""

from __future__ import annotations

import os
import ssl
import urllib.parse
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from typing import Any

import psycopg
from psycopg.rows import dict_row

from {{ pkg }}.config import Settings


def _sslmode(pairs: dict[str, str], host: str) -> str:
    """The libpq sslmode of the Npgsql ``SSL Mode`` setting: Require and VerifyFull verify the server
    certificate and host name (verify-full) unless ``Trust Server Certificate`` is true (require:
    encrypted, not verified); VerifyCA, Prefer, Allow and Disable keep their meaning. Without a
    setting an Azure Database for PostgreSQL host gets verify-full, any other host libpq's default."""
    mode = pairs.get("ssl mode", pairs.get("sslmode", "")).replace(" ", "").lower()
    trust = pairs.get("trust server certificate", pairs.get("trustservercertificate", "")).lower() == "true"
    if mode in ("require", "verifyfull", "verify-full"):
        return "require" if trust else "verify-full"
    if mode in ("verifyca", "verify-ca"):
        return "verify-ca"
    if mode in ("prefer", "allow", "disable"):
        return mode
    if not mode and host.lower().endswith(".postgres.database.azure.com"):
        return "verify-full"
    return ""


def _ca_file() -> str:
    """A real CA file for verify-ca (libpq refuses ``sslrootcert=system`` there): the mirror CA bundle
    when one is configured, else the system CA file."""
    candidates = [os.environ.get("MIRROR_CA_BUNDLE"), ssl.get_default_verify_paths().cafile,
                  "/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt"]
    return next((c for c in candidates if c and os.path.isfile(c)), "/etc/ssl/certs/ca-certificates.crt")


def _roots(parts: dict[str, str]) -> dict[str, str]:
    """libpq needs a root certificate for verify-ca and verify-full and the image has no
    ``~/.postgresql/root.crt``. verify-full reads the system roots (``system``, Azure's are public);
    verify-ca needs a file. Unless the string names a root or ``PGSSLROOTCERT`` does (a private CA
    belongs in the runtime image's store)."""
    mode = parts.get("sslmode")
    if mode in ("verify-ca", "verify-full") and "sslrootcert" not in parts \
            and not os.environ.get("PGSSLROOTCERT"):
        parts["sslrootcert"] = "system" if mode == "verify-full" else _ca_file()
    return parts


def conninfo(value: str) -> str:
    """A libpq connection string or URL for any of the three forms."""
    value = value.strip()
    if value.startswith("jdbc:"):
        url = urllib.parse.urlsplit(value[len("jdbc:"):])
        query = dict(urllib.parse.parse_qsl(url.query))
        parts = {"host": url.hostname or "localhost", "port": str(url.port or 5432), "dbname": url.path.lstrip("/")}
        if "user" in query:
            parts["user"] = query["user"]
        if "password" in query:
            parts["password"] = query["password"]
        if query.get("sslmode") in ("disable", "allow", "prefer", "require", "verify-ca", "verify-full"):
            parts["sslmode"] = query["sslmode"]
        if "sslrootcert" in query:
            parts["sslrootcert"] = query["sslrootcert"]
        return psycopg.conninfo.make_conninfo(**_roots(parts))
    if value.startswith(("postgresql://", "postgres://")):
        query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(value).query))
        root = _roots(dict(query)).get("sslrootcert")
        if root and "sslrootcert" not in query:  # verify-* without a root: add one
            return value + ("&" if "?" in value else "?") + "sslrootcert=" + urllib.parse.quote(root, safe="")
        return value
    pairs: dict[str, str] = {}
    for item in value.split(";"):
        key, eq, val = item.partition("=")
        if eq:
            pairs[key.strip().lower()] = val.strip()
    parts = {"host": pairs.get("host", pairs.get("server", "localhost")), "port": pairs.get("port", "5432"),
             "dbname": pairs.get("database", "")}
    user = pairs.get("username", pairs.get("user id"))
    if user:
        parts["user"] = user
    if "password" in pairs:
        parts["password"] = pairs["password"]
    sslmode = _sslmode(pairs, parts["host"])
    if sslmode:
        parts["sslmode"] = sslmode
    return psycopg.conninfo.make_conninfo(**_roots(parts))


CONNECT_TIMEOUT_S = 10  # seconds to open a connection


class Database:
    def __init__(self, settings: Settings) -> None:
        self.settings = settings

    @asynccontextmanager
    async def connect(self, name: str, key: str, timeout_s: int = 0) -> AsyncIterator[psycopg.AsyncConnection[Any]]:
        """A connection to the resource ``name`` (its setting ``key``) with the TIBCO activity's
        timeout in seconds (0: none); rows come back as dicts."""
        value = self.settings.text(key)
        if not value:
            raise RuntimeError(f"connection string ConnectionStrings__{name} ({key}) is not set")
        extra = {"options": f"-c statement_timeout={timeout_s * 1000}"} if timeout_s > 0 else {}
        # a database that does not answer fails the step instead of hanging it
        connection = await psycopg.AsyncConnection.connect(conninfo(value), autocommit=True, row_factory=dict_row,
                                                           connect_timeout=CONNECT_TIMEOUT_S, **extra)
        try:
            yield connection
        finally:
            await connection.close()

    async def query(self, name: str, key: str, sql: str, params: list[Any], timeout_s: int = 0,
                    max_rows: int = 0) -> list[dict[str, Any]]:
        """The rows of a query; at most ``max_rows`` when it is set (TIBCO maxRows)."""
        async with self.connect(name, key, timeout_s) as connection:
            cursor = await connection.execute(sql, params)
            return await (cursor.fetchmany(max_rows) if max_rows > 0 else cursor.fetchall())

    async def update(self, name: str, key: str, sql: str, params: list[Any], timeout_s: int = 0) -> int:
        """The number of rows a statement changed."""
        async with self.connect(name, key, timeout_s) as connection:
            cursor = await connection.execute(sql, params)
            return max(cursor.rowcount, 0)
