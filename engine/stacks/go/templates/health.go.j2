package platform

import (
	"encoding/json"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"strings"

	"{{ module }}/internal/tib"
)

// Health answers GET /health (anonymous): {"status": "UP"}.
func Health(w http.ResponseWriter, r *http.Request) {
	WriteJSON(w, http.StatusOK, map[string]any{"status": "UP"})
}

// WriteJSON writes a JSON body with its status.
func WriteJSON(w http.ResponseWriter, status int, body any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	if body != nil {
		_, _ = w.Write([]byte(tib.Raw(tib.Of(body))))
	}
}

// WriteProblem writes an application/problem+json body.
func WriteProblem(w http.ResponseWriter, status int, title, detail string) {
	writeProblem(w, tib.Problem(status, title, tib.MaskText(detail)))
}

func writeProblem(w http.ResponseWriter, problem map[string]any) {
	data, _ := json.Marshal(tib.WithoutNulls(problem))
	w.Header().Set("Content-Type", "application/problem+json")
	w.WriteHeader(tib.Integer(problem["status"], http.StatusInternalServerError))
	_, _ = w.Write(data)
}

// WriteResult writes what a process run returned: its status and reply body (none for 204).
func WriteResult(w http.ResponseWriter, result tib.Result) {
	if result.StatusCode == http.StatusNoContent || tib.Absent(result.Body) {
		w.WriteHeader(result.StatusCode)
		return
	}
	WriteJSON(w, result.StatusCode, result.Body)
}

// WriteError writes a failed run: an uncaught TIBCO fault is application/problem+json with
// status 500 (an uncaught BW fault fails the job), the fault name as title and the fault data,
// with its sensitive fields masked, as "fault"; any other error is a plain 500 problem.
func WriteError(w http.ResponseWriter, r *http.Request, err error) {
	if fault, ok := tib.AsFault(err); ok {
		problem := tib.Problem(http.StatusInternalServerError, fault.FaultName(), tib.MaskText(fault.Error()))
		problem["fault"] = tib.MaskJSON(fault.FaultData())
		writeProblem(w, problem)
		return
	}
	var bad *BadRequest
	if errors.As(err, &bad) {
		WriteProblem(w, http.StatusBadRequest, "Bad Request", bad.Detail)
		return
	}
	slog.ErrorContext(r.Context(), "request failed", "path", r.URL.Path, "error", tib.MaskText(err.Error()))
	WriteProblem(w, http.StatusInternalServerError, "Internal Server Error", "the request failed")
}

// BadRequest is a request the service refuses before running the process (400).
type BadRequest struct {
	Detail string
}

// Error is the detail.
func (b *BadRequest) Error() string {
	return b.Detail
}

// Recover answers 500 when a handler panics (a step the Code Builder has not filled yet).
func Recover(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if p := recover(); p != nil {
				if p == http.ErrAbortHandler {
					panic(p)
				}
				slog.ErrorContext(r.Context(), "request panicked", "path", r.URL.Path, "panic", tib.MaskText(fmt.Sprint(p)))
				WriteProblem(w, http.StatusInternalServerError, "Internal Server Error", fmt.Sprint(p))
			}
		}()
		next.ServeHTTP(w, r)
	})
}

// CORS lets the browser call the service from the development origins (CORS_ORIGINS_0, ...,
// Cors__Origins__0 in the environment): the web Verify tab does. Outside development it adds
// nothing.
func CORS(config *Config, next http.Handler) http.Handler {
	if !config.Development() {
		return next
	}
	allowed := map[string]bool{}
	for _, origin := range config.List("CORS_ORIGINS") {
		allowed[strings.TrimSpace(origin)] = true
	}
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		origin := r.Header.Get("Origin")
		if origin != "" && allowed[origin] {
			w.Header().Set("Access-Control-Allow-Origin", origin)
			w.Header().Set("Vary", "Origin")
			if r.Method == http.MethodOptions && r.Header.Get("Access-Control-Request-Method") != "" {
				w.Header().Set("Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
				w.Header().Set("Access-Control-Allow-Headers", or(r.Header.Get("Access-Control-Request-Headers"), "*"))
				w.WriteHeader(http.StatusNoContent)
				return
			}
		}
		next.ServeHTTP(w, r)
	})
}
