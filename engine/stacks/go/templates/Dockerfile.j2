# syntax=docker/dockerfile:1
# {{ module }}: multi-stage build, a static Go {{ go_version }} binary on a distroless runtime, non-root.
# Generated by ExiQO Migrate.
#
# Build arguments. The two base images have NO default, so a build never reaches a public registry
# by accident: pass images from GMF's registry (the pipelines stop when either is empty). Upstream
# equivalents to mirror: {{ base_image_build }} and {{ base_image_runtime }}.
#   BASE_IMAGE_BUILD    the Go toolchain image the binary is built in
#   BASE_IMAGE_RUNTIME  the static runtime image the service runs in (no shell)
#   GOPROXY             the Go module mirror every module comes from (required); the checksums
#                       are the committed go.sum (GOFLAGS=-mod=readonly, GOSUMDB=off)
ARG BASE_IMAGE_BUILD
ARG BASE_IMAGE_RUNTIME

FROM ${BASE_IMAGE_BUILD} AS build
WORKDIR /src
ARG GOPROXY=
ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=readonly \
    GOSUMDB=off \
    GOTOOLCHAIN=local \
    GOTELEMETRY=off \
    GOPROXY=${GOPROXY}

# Download first so the module layer is cached until go.mod or go.sum changes.
COPY go.mod go.sum ./
RUN if [ -z "${GOPROXY}" ]; then echo "GOPROXY is empty: pass GMF's Go module mirror as a build argument" >&2; exit 1; fi \
 && case "${GOPROXY}" in *direct*) echo "GOPROXY must name only the module mirror, not direct" >&2; exit 1 ;; esac \
 && go mod download

COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/server {{ main }}

FROM ${BASE_IMAGE_RUNTIME} AS runtime
WORKDIR /app

ENV PORT=8080
EXPOSE 8080

COPY --from=build /out/server /app/server

# A numeric id lets Kubernetes verify runAsNonRoot (65532 is distroless's nonroot user).
USER 65532
# Exec form: the static runtime has no shell. The service reads PORT.
ENTRYPOINT ["/app/server"]
