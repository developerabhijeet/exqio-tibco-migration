// Command server is {{ app }}: generated by ExiQO Migrate from TIBCO BusinessWorks application
// {{ app_id }}.
//
// It listens on PORT (default 8080). Configuration follows the runtime contract of every ExiQO
// stack (internal/platform): environment names such as Auth__Mode, Messaging__Mode,
// ConnectionStrings__<Resource> and Gmf__<Module>__<Name>; secrets come from Azure Key Vault when
// KeyVault__Uri is set. GET /health answers anonymously.
package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{ module }}/internal/api"
{% if jobs %}
	"{{ module }}/internal/infrastructure/jobs"
{% endif %}
{% if consumers %}
	"{{ module }}/internal/infrastructure/messaging"
{% endif %}
	"{{ module }}/internal/platform"
)

func main() {
	if err := run(); err != nil {
		slog.Error("the service stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	config, err := platform.Load(ctx)
	if err != nil {
		return err
	}
	deps, err := api.NewDeps(config)
	if err != nil {
		return err
	}
	defer deps.Close()
{% if consumers %}
	stopConsumers, err := messaging.Start(deps.Bus, deps.Services)
	if err != nil {
		return err
	}
	defer stopConsumers()
{% endif %}
{% if jobs %}
	jobs.Start(ctx, config, deps.Services)
{% endif %}
	port := config.Get("PORT")
	if port == "" {
		port = "8080"
	}
	server := &http.Server{Addr: config.Get("HOST") + ":" + port, Handler: api.NewRouter(deps), ReadHeaderTimeout: 30 * time.Second}
	failed := make(chan error, 1)
	go func() {
		slog.Info("listening", "address", server.Addr)
		failed <- server.ListenAndServe()
	}()
	select {
	case err := <-failed:
		if !errors.Is(err, http.ErrServerClosed) {
			return err
		}
	case <-ctx.Done():
	}
	shutdown, cancel := context.WithTimeout(context.Background(), 20*time.Second)
	defer cancel()
	return server.Shutdown(shutdown)
}
