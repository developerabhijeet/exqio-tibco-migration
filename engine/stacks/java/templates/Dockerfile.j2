# syntax=docker/dockerfile:1
# {{ artifact }}: multi-stage build, Java {{ java_release }} runtime, non-root. Generated by ExiQO Migrate.
#
# Build arguments. The two base images have NO default, so a build never reaches a public registry
# by accident: pass images from GMF's registry (the pipelines stop when either is empty). Upstream
# equivalents to mirror: {{ base_image_build }} and {{ base_image_runtime }}.
#   BASE_IMAGE_BUILD    the Maven + JDK image the jar is built in
#   BASE_IMAGE_RUNTIME  the JRE image the service runs in
#   MAVEN_MIRROR_URL    the Maven repository every dependency comes from (required; empty fails the build)
#                       the project was generated with (.exiqo/maven-settings.xml)
ARG BASE_IMAGE_BUILD
ARG BASE_IMAGE_RUNTIME

FROM ${BASE_IMAGE_BUILD} AS build
WORKDIR /src
ARG MAVEN_MIRROR_URL=

# Resolve first so the dependency layer is cached until pom.xml changes.
COPY pom.xml ./
COPY .exiqo/maven-settings.xml .exiqo/
RUN test -n "${MAVEN_MIRROR_URL}" || { echo "MAVEN_MIRROR_URL is empty: pass GMF's Maven mirror as a build argument (never Maven Central)" >&2; exit 1; } \
 && printf '%s\n' '<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"><mirrors><mirror><id>gmf</id><mirrorOf>*</mirrorOf><url>${env.MAVEN_MIRROR_URL}</url></mirror></mirrors></settings>' \
      > .exiqo/maven-settings.xml \
 && mvn -B -ntp -s .exiqo/maven-settings.xml {{ restore_goals }}

COPY src ./src
RUN mvn -B -ntp -o -s .exiqo/maven-settings.xml -DskipTests package

FROM ${BASE_IMAGE_RUNTIME} AS runtime
WORKDIR /app

ENV PORT=8080 \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
EXPOSE 8080

COPY --from=build /src/{{ jar }} app.jar

# A numeric id lets Kubernetes verify runAsNonRoot; /tmp is the only path the service writes.
USER 10001
# Exec form (no shell: distroless and chiseled runtimes have none); application.yml reads PORT.
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
