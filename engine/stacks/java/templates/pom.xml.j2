<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by ExiQO Migrate from TIBCO BusinessWorks application {{ app_id }}. -->
<!-- Versions are pinned by ExiQO (engine/stacks/java/versions.py); repositories come from the -->
<!-- GMF mirror in .exiqo/maven-settings.xml, never from this file. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>{{ v.SPRING_BOOT }}</version>
    <relativePath/>
  </parent>

  <groupId>{{ v.GROUP_ID }}</groupId>
  <artifactId>{{ artifact }}</artifactId>
  <version>1.0.0</version>
  <name>{{ app }}</name>
  <description>{{ app }} service migrated from TIBCO BusinessWorks application {{ app_id }}</description>

  <properties>
    <java.version>{{ v.JAVA_RELEASE }}</java.version>
    <maven.compiler.release>{{ v.JAVA_RELEASE }}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <postgresql.version>{{ v.POSTGRESQL }}</postgresql.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-sdk-bom</artifactId>
        <version>{{ v.AZURE_SDK_BOM }}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
{% for group, artifact_id, scope in v.DEPENDENCIES %}
    <dependency>
      <groupId>{{ group }}</groupId>
      <artifactId>{{ artifact_id }}</artifactId>
{% if scope %}
      <scope>{{ scope }}</scope>
{% endif %}
    </dependency>
{% endfor %}
  </dependencies>

  <build>
    <finalName>{{ artifact }}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <!-- Surefire picks its JUnit Platform provider at test time; declared so dependency:go-offline caches it. -->
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit-platform</artifactId>
            <version>${maven-surefire-plugin.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>{{ v.JACOCO }}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>{{ v.SPOTLESS }}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>{{ v.PALANTIR_JAVA_FORMAT }}</version>
            </palantirJavaFormat>
            <!-- No removeUnusedImports: the generated tests import their whole vocabulary on purpose. -->
          </java>
        </configuration>
        <dependencies>
          <!-- Declared so dependency:go-offline caches the formatter for the offline format gate. -->
          <dependency>
            <groupId>com.palantir.javaformat</groupId>
            <artifactId>palantir-java-format</artifactId>
            <version>{{ v.PALANTIR_JAVA_FORMAT }}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
