<!-- Generated by ExiQO Migrate: the Maven settings every build of this project uses (mvn -s). -->
{% if maven %}
<!-- Every repository is reached through the GMF mirror (MAVEN_MIRROR_URL). -->
{% else %}
<!-- No mirror is configured (MAVEN_MIRROR_URL is empty): Maven's own defaults apply. -->
{% endif %}
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
{% if maven %}
