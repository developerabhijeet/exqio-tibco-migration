#!/usr/bin/env bash
# Creates the Terraform state storage that infra/live/root.hcl points at, for [[ app_id ]].
# Generated by ExiQO Migrate. Run once per subscription before the first terragrunt run
# (az login first). The names match root.hcl and can be overridden with the same variables.
#
# Storage accounts allow Microsoft Entra ID access only (no shared keys), as root.hcl sets
# use_azuread_auth = true. The identity that runs Terragrunt needs "Storage Blob Data Contributor"
# on the account; DEPLOY_PRINCIPAL_ID grants it here.
set -euo pipefail

LOCATION="${AZURE_LOCATION:-[[ location ]]}"
RESOURCE_GROUP="${TF_STATE_RESOURCE_GROUP:-[[ state.resource_group ]]}"
STORAGE_ACCOUNT="${TF_STATE_STORAGE_ACCOUNT:-[[ state.storage_account ]]}"
CONTAINER="${TF_STATE_CONTAINER:-[[ state.container ]]}"

az group create --name "$RESOURCE_GROUP" --location "$LOCATION" --output none

az storage account create \
  --name "$STORAGE_ACCOUNT" \
  --resource-group "$RESOURCE_GROUP" \
  --location "$LOCATION" \
  --sku Standard_LRS \
  --kind StorageV2 \
  --min-tls-version TLS1_2 \
  --allow-blob-public-access false \
  --allow-shared-key-access false \
  --output none

az storage account blob-service-properties update \
  --account-name "$STORAGE_ACCOUNT" \
  --resource-group "$RESOURCE_GROUP" \
  --enable-versioning true \
  --output none

STORAGE_ID="$(az storage account show --name "$STORAGE_ACCOUNT" --resource-group "$RESOURCE_GROUP" --query id --output tsv)"

if [ -n "${DEPLOY_PRINCIPAL_ID:-}" ]; then
  az role assignment create \
    --assignee-object-id "$DEPLOY_PRINCIPAL_ID" \
    --assignee-principal-type ServicePrincipal \
    --role "Storage Blob Data Contributor" \
    --scope "$STORAGE_ID" \
    --output none
fi

# Creating the container needs data-plane rights as well; grant yourself the role first if this fails.
az storage container create --name "$CONTAINER" --account-name "$STORAGE_ACCOUNT" --auth-mode login --output none

echo "State storage ready: $STORAGE_ACCOUNT/$CONTAINER in $RESOURCE_GROUP"
