# Local run for [[ solution ]]: Postgres plus the API with the in-memory message bus.
# Self-contained, so it also works on its own: docker compose -f docker-compose.override.yml up --build
# Generated by ExiQO Migrate. The credentials below are local-only.
services:
  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: [[ databases[0] ]]
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
[% if databases | length > 1 %]
      - ./infra/local/initdb:/docker-entrypoint-initdb.d:ro
[% endif %]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d [[ databases[0] ]]"]
      interval: 5s
      timeout: 3s
      retries: 10

  api:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        # Debug keeps the development endpoints that Auth__Mode=Development needs; Release removes them.
        CONFIGURATION: Debug
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "8080:8080"
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      Auth__Mode: Development
      Messaging__Mode: InMemory
      KeyVault__Uri: ""
[% for name, db in connection_strings %]
      ConnectionStrings__[[ name ]]: "Host=postgres;Port=5432;Database=[[ db ]];Username=app;Password=app"
[% endfor %]

volumes:
  pgdata:
