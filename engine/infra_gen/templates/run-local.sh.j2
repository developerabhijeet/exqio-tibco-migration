#!/usr/bin/env bash
# Runs [[ solution ]] on this machine and opens its Swagger UI.
# Generated by ExiQO Migrate from TIBCO BusinessWorks application [[ app_id ]].
#
# Two ways to run, both from this folder:
#   bash run-local.sh            Docker: Postgres plus the API, exactly as docker-compose.override.yml describes
#   bash run-local.sh --dotnet   .NET SDK only: the API against a Postgres you already run
#
# Everything this script sets is development configuration: Auth:Mode=Development issues the bearer
# token Swagger needs, Messaging:Mode=InMemory replaces Azure Service Bus, and the Postgres password
# is local-only. None of it is used by the deployed application, which reads its secrets from Key Vault.
set -euo pipefail

cd "$(dirname "$0")"

API_URL="http://localhost:[[ port ]]"
SWAGGER_URL="$API_URL/swagger"
MODE="docker"
[ "${1:-}" = "--dotnet" ] && MODE="dotnet"

say() { printf '\n\033[1;35m==>\033[0m %s\n' "$1"; }
die() { printf '\n\033[1;31mrun-local.sh:\033[0m %s\n' "$1" >&2; exit 1; }

# Waits for GET /health to answer 200, and says what it last saw if it never does.
wait_for_health() {
  local tries=${1:-90} answer=""
  printf 'Waiting for %s/health ' "$API_URL"
  for _ in $(seq 1 "$tries"); do
    answer=$(curl -s -o /dev/null -w '%{http_code}' "$API_URL/health" 2>/dev/null || echo "000")
    if [ "$answer" = "200" ]; then
      printf ' up\n'
      return 0
    fi
    printf '.'
    sleep 2
  done
  printf '\n'
  die "the API did not answer /health with 200 (last answer: $answer). The log above says why."
}

# The token Swagger's Authorize dialog takes. Development auth only.
print_token() {
  local token
  token=$(curl -s -X POST "$API_URL/auth/dev-token" -H 'content-type: application/json' \
    -d '{"subject":"local-run"}' 2>/dev/null | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')
  say "Swagger: $SWAGGER_URL"
  if [ -n "$token" ]; then
    echo "Select Authorize in Swagger and paste this bearer token:"
    echo
    echo "$token"
  else
    echo "For a bearer token:"
    echo "  curl -s -X POST $API_URL/auth/dev-token -H 'content-type: application/json' -d '{\"subject\":\"local-run\"}'"
  fi
  echo
  echo "Endpoints: $API_URL/health (no token) and the controllers listed in Swagger (bearer token)."
}

if [ "$MODE" = "docker" ]; then
  command -v docker >/dev/null 2>&1 || die "docker is not on PATH. Install Docker Desktop, or run: bash run-local.sh --dotnet"
  docker compose version >/dev/null 2>&1 || die "this Docker has no 'compose' command. Install Docker Compose v2, or run: bash run-local.sh --dotnet"
  docker info >/dev/null 2>&1 || die "the Docker daemon is not running. Start Docker Desktop and try again."

  say "Building the image and starting Postgres and the API"
  docker compose -f docker-compose.override.yml up --build -d
  wait_for_health 120
  print_token
  echo
  echo "Logs: docker compose -f docker-compose.override.yml logs -f api"
  echo "Stop: docker compose -f docker-compose.override.yml down        (add -v to drop the database)"
else
  command -v dotnet >/dev/null 2>&1 || die "dotnet is not on PATH. Install the .NET [[ dotnet_version ]] SDK."
  say "Restoring and starting [[ api_project ]]"
  echo "This path needs a Postgres you already run. The connection strings below point at localhost:5432."
  echo

  export ASPNETCORE_ENVIRONMENT=Development
  export ASPNETCORE_URLS="http://localhost:[[ port ]]"
  export Auth__Mode=Development
  export Messaging__Mode=InMemory
  export KeyVault__Uri=""
[% for name, db in connection_strings %]
  export ConnectionStrings__[[ name ]]="Host=localhost;Port=5432;Database=[[ db ]];Username=app;Password=app"
[% endfor %]

  dotnet restore "[[ sln ]]"
  # Started in the background so this script can wait for /health and print the token; Ctrl+C stops both.
  dotnet run --project "[[ api_project ]]" --no-launch-profile &
  API_PID=$!
  trap 'kill "$API_PID" 2>/dev/null || true' EXIT INT TERM
  wait_for_health 90
  print_token
  echo
  echo "Press Ctrl+C to stop."
  wait "$API_PID"
fi
