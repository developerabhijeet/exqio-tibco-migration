# [[ app_id ]]: build, test, image push, Terragrunt plan on pull requests, apply per environment.
# Generated by ExiQO Migrate. Azure access uses OIDC federation: no client secret is stored.
#
# Repository or organization variables: AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID
# (read-only identity used for plans). Each GitHub environment ([[ envs | map(attribute='name') | join(', ') ]]) overrides them
# with its own deploy identity; add required reviewers to the "[[ envs[-1].name ]]" environment so apply waits for approval.
# Secret: PG_ADMIN_PASSWORD. Optional variables: TF_STATE_RESOURCE_GROUP, TF_STATE_STORAGE_ACCOUNT.
name: [[ app_slug ]]

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: [[ app_slug ]]-${{ github.ref }}
  cancel-in-progress: false

permissions:
  id-token: write
  contents: read
  pull-requests: write

env:
  DOTNET_VERSION: 10.0.x
  DOTNET_CLI_TELEMETRY_OPTOUT: "1"
  SOLUTION: [[ sln ]]
  IMAGE_NAME: [[ image_name ]]
  TERRAFORM_VERSION: "[[ terraform_version ]]"
  TERRAGRUNT_VERSION: [[ terragrunt_version ]]
  APP_DIR: [[ app_slug ]]
  ARM_USE_OIDC: "true"

[% macro tools() %]
- name: Set up Terraform
  uses: hashicorp/setup-terraform@v3
  with:
    terraform_version: ${{ env.TERRAFORM_VERSION }}
    terraform_wrapper: false
- name: Install Terragrunt
  run: |
    curl -sSL -o terragrunt "https://github.com/gruntwork-io/terragrunt/releases/download/${TERRAGRUNT_VERSION}/terragrunt_linux_amd64"
    sudo install terragrunt /usr/local/bin/terragrunt
    terragrunt --version
[% endmacro %]
jobs:
  build-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: ${{ env.DOTNET_VERSION }}
      - name: Restore
        run: dotnet restore "$SOLUTION"
      - name: Build
        run: dotnet build "$SOLUTION" --configuration Release --no-restore
      - name: Test
        run: >
          dotnet test "$SOLUTION" --configuration Release --no-build
          --logger "trx;LogFileName=results.trx" --results-directory TestResults
          --collect:"XPlat Code Coverage"
      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: TestResults/**
          if-no-files-found: warn

  validate-infra:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      [[ tools() | trim | indent(6) ]]
      - name: Format check
        run: |
          terraform fmt -check -recursive infra/modules
          # Terragrunt 1.x names this "hcl fmt"; releases before 0.78 call it "hclfmt".
          (cd infra/live && terragrunt hcl fmt --check)
      - name: Validate modules
        run: |
          for dir in infra/modules/*/; do
            echo "::group::$dir"
            terraform -chdir="$dir" init -backend=false -input=false
            terraform -chdir="$dir" validate
            echo "::endgroup::"
          done

  plan:
    if: github.event_name == 'pull_request'
    needs: [build-test, validate-infra]
    runs-on: ubuntu-latest
    env:
      ARM_CLIENT_ID: ${{ vars.AZURE_CLIENT_ID }}
      ARM_TENANT_ID: ${{ vars.AZURE_TENANT_ID }}
      ARM_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      TF_STATE_RESOURCE_GROUP: ${{ vars.TF_STATE_RESOURCE_GROUP }}
      TF_STATE_STORAGE_ACCOUNT: ${{ vars.TF_STATE_STORAGE_ACCOUNT }}
      PG_ADMIN_PASSWORD: ${{ secrets.PG_ADMIN_PASSWORD }}
      IMAGE_TAG: ${{ github.event.pull_request.head.sha }}
    steps:
      - uses: actions/checkout@v4
      - uses: azure/login@v2
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      [[ tools() | trim | indent(6) ]]
      # "run-all" was removed in Terragrunt 1.0; "run --all" is the same stack-wide plan.
      - name: Terragrunt plan ([[ envs[0].name ]])
        working-directory: infra/live/[[ envs[0].name ]]
        shell: bash
        run: terragrunt run --all --non-interactive -- plan -lock=false -no-color | tee "$RUNNER_TEMP/plan.txt"
      - name: Upload plan
        uses: actions/upload-artifact@v4
        with:
          name: plan-[[ envs[0].name ]]
          path: ${{ runner.temp }}/plan.txt

  image:
    if: github.event_name != 'pull_request'
    needs: [build-test, validate-infra]
    runs-on: ubuntu-latest
    environment: [[ envs[0].name ]]
    env:
      ARM_CLIENT_ID: ${{ vars.AZURE_CLIENT_ID }}
      ARM_TENANT_ID: ${{ vars.AZURE_TENANT_ID }}
      ARM_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      TF_STATE_RESOURCE_GROUP: ${{ vars.TF_STATE_RESOURCE_GROUP }}
      TF_STATE_STORAGE_ACCOUNT: ${{ vars.TF_STATE_STORAGE_ACCOUNT }}
      ACR_NAME: [[ envs[0].acr ]]
    steps:
      - uses: actions/checkout@v4
      - uses: azure/login@v2
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      [[ tools() | trim | indent(6) ]]
      - name: Create the resource group and registry
        run: |
          for unit in resource_group container_registry; do
            (cd "infra/live/[[ envs[0].name ]]/${APP_DIR}/${unit}" && terragrunt run --non-interactive -- apply -auto-approve)
          done
      - name: Build and push the image
        run: |
          az acr login --name "$ACR_NAME"
          docker build --tag "${ACR_NAME}.azurecr.io/${IMAGE_NAME}:${GITHUB_SHA}" .
          docker push "${ACR_NAME}.azurecr.io/${IMAGE_NAME}:${GITHUB_SHA}"
[% for env in envs %]

  apply-[[ env.name ]]:
    needs: [[ env.needs_gh ]]
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    # Required reviewers on this GitHub environment hold the job until someone approves.
    environment: [[ env.name ]]
    env:
      ARM_CLIENT_ID: ${{ vars.AZURE_CLIENT_ID }}
      ARM_TENANT_ID: ${{ vars.AZURE_TENANT_ID }}
      ARM_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      TF_STATE_RESOURCE_GROUP: ${{ vars.TF_STATE_RESOURCE_GROUP }}
      TF_STATE_STORAGE_ACCOUNT: ${{ vars.TF_STATE_STORAGE_ACCOUNT }}
      PG_ADMIN_PASSWORD: ${{ secrets.PG_ADMIN_PASSWORD }}
      IMAGE_TAG: ${{ github.sha }}
      ACR_NAME: [[ env.acr ]]
    steps:
      - uses: actions/checkout@v4
      - uses: azure/login@v2
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      [[ tools() | trim | indent(6) ]]
[% if not loop.first %]
      - name: Create the resource group and registry
        run: |
          for unit in resource_group container_registry; do
            (cd "infra/live/[[ env.name ]]/${APP_DIR}/${unit}" && terragrunt run --non-interactive -- apply -auto-approve)
          done
      - name: Promote the image from the [[ envs[0].name ]] registry
        run: >
          az acr import --name "$ACR_NAME" --force
          --source "[[ envs[0].acr ]].azurecr.io/${IMAGE_NAME}:${GITHUB_SHA}"
          --image "${IMAGE_NAME}:${GITHUB_SHA}"
          --registry "/subscriptions/${ARM_SUBSCRIPTION_ID}/resourceGroups/rg-${APP_DIR}-[[ envs[0].name ]]/providers/Microsoft.ContainerRegistry/registries/[[ envs[0].acr ]]"
[% endif %]
      - name: Terragrunt apply ([[ env.name ]])
        working-directory: infra/live/[[ env.name ]]
        run: terragrunt run --all --non-interactive -- apply
[% endfor %]
