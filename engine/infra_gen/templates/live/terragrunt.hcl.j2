# Root Terragrunt configuration for [[ app_id ]]. Generated by ExiQO Migrate.
# Every unit under live/<env>/[[ app_slug ]]/<module> includes this file.
locals {
  path_parts = split("/", path_relative_to_include())
  env        = local.path_parts[0]
  app        = local.path_parts[1]
  module     = local.path_parts[2]

  location              = get_env("AZURE_LOCATION", "[[ location ]]")
  state_resource_group  = get_env("TF_STATE_RESOURCE_GROUP", "[[ state_resource_group ]]")
  state_storage_account = get_env("TF_STATE_STORAGE_ACCOUNT", "[[ state_storage_account ]]")
  state_container       = get_env("TF_STATE_CONTAINER", "[[ state_container ]]")
}

remote_state {
  backend = "azurerm"

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }

  config = {
    resource_group_name  = local.state_resource_group
    storage_account_name = local.state_storage_account
    container_name       = local.state_container
    key                  = "${local.app}/${local.env}/${local.module}.tfstate"
    use_azuread_auth     = true
  }
}

# The azurerm provider reads ARM_SUBSCRIPTION_ID, ARM_TENANT_ID, ARM_CLIENT_ID and ARM_USE_OIDC.
generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<-EOF
    provider "azurerm" {
      features {}
    }
  EOF
}

inputs = {
  location = local.location

  tags = {
    application = "[[ app_id ]]"
    environment = local.env
    managed-by  = "terragrunt"
    generator   = "exiqo-migrate"
  }
}
