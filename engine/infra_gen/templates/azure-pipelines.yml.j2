# [[ app_id ]]: build, test, image push, Terragrunt plan on pull requests, apply per environment.
# Generated by ExiQO Migrate. Same stages as .github/workflows/[[ app_slug ]].yml.
#
# Setup, once:
#   1. bash [[ tfstate_script ]] creates the Terraform state storage.
#   2. An Azure Resource Manager service connection with workload identity federation (OIDC), named
#      in azureServiceConnection below.
#   3. A variable group "[[ app_slug ]]-infra" holding PG_ADMIN_PASSWORD (secret) and optionally
#      TF_STATE_RESOURCE_GROUP / TF_STATE_STORAGE_ACCOUNT.
#   4. Azure DevOps environments ([[ envs | map(attribute='name') | join(', ') ]]) with approvals on "[[ envs[-1].name ]]".
trigger:
  branches:
    include: [main]

pr:
  branches:
    include: [main]

pool:
  vmImage: ubuntu-latest

variables:
  - group: [[ app_slug ]]-infra
  - name: azureServiceConnection
    value: [[ app_slug ]]-azure
  - name: solution
    value: [[ sln ]]
  - name: imageName
    value: [[ image_name ]]
  - name: terraformVersion
    value: "[[ terraform_version ]]"
  - name: terragruntVersion
    value: [[ terragrunt_version ]]
  - name: appDir
    value: [[ app_slug ]]

[% macro tools() %]
- script: |
    curl -sSL -o terraform.zip "https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip"
    unzip -o terraform.zip terraform
    sudo install terraform /usr/local/bin/terraform
    curl -sSL -o terragrunt "https://github.com/gruntwork-io/terragrunt/releases/download/$(terragruntVersion)/terragrunt_linux_amd64"
    sudo install terragrunt /usr/local/bin/terragrunt
    terraform version
    terragrunt --version
  displayName: Install Terraform and Terragrunt
[% endmacro %]
[% macro azure_env() %]
export ARM_USE_OIDC=true
export ARM_CLIENT_ID="$servicePrincipalId"
export ARM_TENANT_ID="$tenantId"
export ARM_OIDC_TOKEN="$idToken"
export ARM_SUBSCRIPTION_ID="$(az account show --query id -o tsv)"
[% endmacro %]
stages:
  - stage: Build
    jobs:
      - job: build_test
        steps:
          - task: UseDotNet@2
            displayName: Use .NET 10
            inputs:
              packageType: sdk
              version: 10.0.x
          - task: DotNetCoreCLI@2
            displayName: Restore
            inputs:
              command: restore
              projects: $(solution)
          - task: DotNetCoreCLI@2
            displayName: Build
            inputs:
              command: build
              projects: $(solution)
              arguments: --configuration Release --no-restore
          - task: DotNetCoreCLI@2
            displayName: Test
            inputs:
              command: test
              projects: $(solution)
              publishTestResults: false
              arguments: >-
                --configuration Release --no-build --collect:"XPlat Code Coverage"
                --logger "trx;LogFileName=results.trx" --results-directory $(Agent.TempDirectory)/TestResults
          - task: PublishTestResults@2
            displayName: Publish test results
            condition: succeededOrFailed()
            inputs:
              testResultsFormat: VSTest
              testResultsFiles: "**/*.trx"
              searchFolder: $(Agent.TempDirectory)/TestResults

  - stage: ValidateInfra
    dependsOn: []
    jobs:
      - job: validate
        steps:
          [[ tools() | trim | indent(10) ]]
          - script: |
              terraform fmt -check -recursive infra/modules
              # Terragrunt 1.x names this "hcl fmt"; releases before 0.78 call it "hclfmt".
              (cd infra/live && terragrunt hcl fmt --check)
            displayName: Format check
          - script: |
              for dir in infra/modules/*/; do
                terraform -chdir="$dir" init -backend=false -input=false
                terraform -chdir="$dir" validate
              done
            displayName: Validate modules

  - stage: Plan
    dependsOn: [Build, ValidateInfra]
    condition: and(succeeded(), eq(variables['Build.Reason'], 'PullRequest'))
    jobs:
      - job: plan
        steps:
          [[ tools() | trim | indent(10) ]]
          # "run-all" was removed in Terragrunt 1.0; "run --all" is the same stack-wide plan.
          - task: AzureCLI@2
            displayName: Terragrunt plan ([[ envs[0].name ]])
            inputs:
              azureSubscription: $(azureServiceConnection)
              scriptType: bash
              scriptLocation: inlineScript
              addSpnToEnvironment: true
              workingDirectory: infra/live/[[ envs[0].name ]]
              inlineScript: |
                [[ azure_env() | trim | indent(16) ]]
                export PG_ADMIN_PASSWORD="$(PG_ADMIN_PASSWORD)"
                export IMAGE_TAG="$(Build.SourceVersion)"
                terragrunt run --all --non-interactive -- plan -lock=false -no-color

  - stage: Image
    dependsOn: [Build, ValidateInfra]
    condition: and(succeeded(), ne(variables['Build.Reason'], 'PullRequest'), eq(variables['Build.SourceBranch'], 'refs/heads/main'))
    jobs:
      - job: image
        steps:
          [[ tools() | trim | indent(10) ]]
          - task: AzureCLI@2
            displayName: Create the registry and push the image
            inputs:
              azureSubscription: $(azureServiceConnection)
              scriptType: bash
              scriptLocation: inlineScript
              addSpnToEnvironment: true
              inlineScript: |
                [[ azure_env() | trim | indent(16) ]]
                for unit in resource_group container_registry; do
                  (cd "infra/live/[[ envs[0].name ]]/$(appDir)/$unit" && terragrunt run --non-interactive -- apply -auto-approve)
                done
                az acr login --name [[ envs[0].acr ]]
                docker build --tag "[[ envs[0].acr ]].azurecr.io/$(imageName):$(Build.SourceVersion)" .
                docker push "[[ envs[0].acr ]].azurecr.io/$(imageName):$(Build.SourceVersion)"
[% for env in envs %]

  - stage: Apply_[[ env.name ]]
    dependsOn: [[ env.needs_ado ]]
    condition: succeeded()
    jobs:
      - deployment: apply
        # Approvals and checks on this Azure DevOps environment hold the stage until someone approves.
        environment: [[ env.name ]]
        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: self
                [[ tools() | trim | indent(16) ]]
                - task: AzureCLI@2
                  displayName: Terragrunt apply ([[ env.name ]])
                  inputs:
                    azureSubscription: $(azureServiceConnection)
                    scriptType: bash
                    scriptLocation: inlineScript
                    addSpnToEnvironment: true
                    inlineScript: |
                      [[ azure_env() | trim | indent(22) ]]
                      export PG_ADMIN_PASSWORD="$(PG_ADMIN_PASSWORD)"
                      export IMAGE_TAG="$(Build.SourceVersion)"
                      cd infra/live/[[ env.name ]]
[% if not loop.first %]
                      for unit in resource_group container_registry; do
                        (cd "$(appDir)/$unit" && terragrunt run --non-interactive -- apply -auto-approve)
                      done
                      az acr import --name [[ env.acr ]] --force \
                        --source "[[ envs[0].acr ]].azurecr.io/$(imageName):$(Build.SourceVersion)" \
                        --image "$(imageName):$(Build.SourceVersion)" \
                        --registry "/subscriptions/${ARM_SUBSCRIPTION_ID}/resourceGroups/rg-$(appDir)-[[ envs[0].name ]]/providers/Microsoft.ContainerRegistry/registries/[[ envs[0].acr ]]"
[% endif %]
                      terragrunt run --all --non-interactive -- apply
[% endfor %]
