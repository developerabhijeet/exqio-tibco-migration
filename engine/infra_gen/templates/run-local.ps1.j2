# Runs [[ solution ]] on this machine and opens its Swagger UI.
# Generated by ExiQO Migrate from TIBCO BusinessWorks application [[ app_id ]].
#
# Two ways to run, both from this folder:
#   powershell -ExecutionPolicy Bypass -File run-local.ps1            Docker: Postgres plus the API
#   powershell -ExecutionPolicy Bypass -File run-local.ps1 -Dotnet    .NET SDK only, against a Postgres you run
#
# Everything this script sets is development configuration: Auth:Mode=Development issues the bearer
# token Swagger needs, Messaging:Mode=InMemory replaces Azure Service Bus, and the Postgres password
# is local-only. None of it is used by the deployed application, which reads its secrets from Key Vault.
[CmdletBinding()]
param([switch]$Dotnet)

$ErrorActionPreference = 'Stop'
Set-Location -LiteralPath $PSScriptRoot

$ApiUrl = 'http://localhost:[[ port ]]'
$SwaggerUrl = "$ApiUrl/swagger"

function Say($message) { Write-Host "`n==> $message" -ForegroundColor Magenta }
function Die($message) { Write-Host "`nrun-local.ps1: $message" -ForegroundColor Red; exit 1 }
function Have($name) { $null -ne (Get-Command $name -ErrorAction SilentlyContinue) }

# Waits for GET /health to answer 200, and says what it last saw if it never does.
function Wait-ForHealth($tries = 90) {
    Write-Host "Waiting for $ApiUrl/health " -NoNewline
    $answer = 'no answer'
    for ($i = 0; $i -lt $tries; $i++) {
        try {
            $response = Invoke-WebRequest -Uri "$ApiUrl/health" -UseBasicParsing -TimeoutSec 3
            if ($response.StatusCode -eq 200) { Write-Host ' up'; return }
            $answer = $response.StatusCode
        } catch {
            $answer = $_.Exception.Message
        }
        Write-Host '.' -NoNewline
        Start-Sleep -Seconds 2
    }
    Write-Host ''
    Die "the API did not answer /health with 200 (last answer: $answer). The log above says why."
}

# The token Swagger's Authorize dialog takes. Development auth only.
function Show-Token {
    $token = $null
    try {
        $answer = Invoke-RestMethod -Method Post -Uri "$ApiUrl/auth/dev-token" `
            -ContentType 'application/json' -Body '{"subject":"local-run"}'
        $token = $answer.access_token
    } catch {
        $token = $null
    }
    Say "Swagger: $SwaggerUrl"
    if ($token) {
        Write-Host 'Select Authorize in Swagger and paste this bearer token:'
        Write-Host ''
        Write-Host $token
    } else {
        Write-Host 'For a bearer token:'
        # Single-quoted so the JSON body's double quotes survive; PowerShell does not take \" as an escape.
        Write-Host ('  Invoke-RestMethod -Method Post -Uri ' + $ApiUrl + '/auth/dev-token -ContentType ''application/json'' -Body ''{"subject":"local-run"}''')
    }
    Write-Host ''
    Write-Host "Endpoints: $ApiUrl/health (no token) and the controllers listed in Swagger (bearer token)."
}

if (-not $Dotnet) {
    if (-not (Have 'docker')) { Die 'docker is not on PATH. Install Docker Desktop, or run with -Dotnet.' }
    & docker info *> $null
    if ($LASTEXITCODE -ne 0) { Die 'the Docker daemon is not running. Start Docker Desktop and try again.' }

    Say 'Building the image and starting Postgres and the API'
    & docker compose -f docker-compose.override.yml up --build -d
    if ($LASTEXITCODE -ne 0) { Die 'docker compose could not start the stack. The log above says why.' }
    Wait-ForHealth 120
    Show-Token
    Write-Host ''
    Write-Host 'Logs: docker compose -f docker-compose.override.yml logs -f api'
    Write-Host 'Stop: docker compose -f docker-compose.override.yml down        (add -v to drop the database)'
} else {
    if (-not (Have 'dotnet')) { Die 'dotnet is not on PATH. Install the .NET [[ dotnet_version ]] SDK.' }
    Say 'Restoring and starting [[ api_project ]]'
    Write-Host 'This path needs a Postgres you already run. The connection strings below point at localhost:5432.'
    Write-Host ''

    $env:ASPNETCORE_ENVIRONMENT = 'Development'
    $env:ASPNETCORE_URLS = 'http://localhost:[[ port ]]'
    $env:Auth__Mode = 'Development'
    $env:Messaging__Mode = 'InMemory'
    $env:KeyVault__Uri = ''
[% for name, db in connection_strings %]
    $env:ConnectionStrings__[[ name ]] = 'Host=localhost;Port=5432;Database=[[ db ]];Username=app;Password=app'
[% endfor %]

    & dotnet restore '[[ sln ]]'
    if ($LASTEXITCODE -ne 0) { Die 'dotnet restore failed. This machine needs access to the NuGet feed.' }
    # Started as a job so this script can wait for /health and print the token.
    $api = Start-Process -FilePath 'dotnet' `
        -ArgumentList 'run', '--project', '[[ api_project ]]', '--no-launch-profile' -NoNewWindow -PassThru
    try {
        Wait-ForHealth 90
        Show-Token
        Write-Host ''
        Write-Host 'Press Ctrl+C to stop.'
        Wait-Process -Id $api.Id
    } finally {
        if (-not $api.HasExited) { Stop-Process -Id $api.Id -Force -ErrorAction SilentlyContinue }
    }
}
