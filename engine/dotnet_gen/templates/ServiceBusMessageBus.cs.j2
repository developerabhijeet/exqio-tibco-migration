using System.Collections.Concurrent;
using System.Globalization;
using System.Text.Json;
using Azure.Messaging.ServiceBus;
using {{ app }}.Core.Messaging;
using Microsoft.Extensions.Logging;

namespace {{ app }}.Infrastructure.Messaging;

/// <summary>
/// Azure Service Bus implementation of <see cref="IMessageBus"/> (<c>Messaging:Mode=ServiceBus</c>).
/// Queues and topics keep their TIBCO names; a topic consumer subscribes as <c>topic/subscription</c>
/// (the subscription rule carries the consumer's <c>SelectorFilter</c>, created by the infrastructure).
/// Messages are settled explicitly (<c>AutoCompleteMessages = false</c>): completed or dead-lettered as
/// the consumer decides; only an exception (a transient failure) abandons the message, and Service Bus
/// then redelivers it up to the entity's MaxDeliveryCount before dead-lettering it.
/// </summary>
public sealed class ServiceBusMessageBus(ServiceBusClient client, ILogger<ServiceBusMessageBus> logger) : IMessageBus, IAsyncDisposable
{
    private readonly ConcurrentDictionary<string, ServiceBusSender> _senders = new(StringComparer.Ordinal);

    public async Task PublishAsync<T>(string entity, T message, IReadOnlyDictionary<string, string>? properties = null, CancellationToken cancellationToken = default)
    {
        var sender = _senders.GetOrAdd(entity, name => client.CreateSender(name));
        var outgoing = new ServiceBusMessage(BinaryData.FromString(JsonSerializer.Serialize(message, BusJson.Options)))
        {
            ContentType = "application/json",
        };
        if (properties is not null)
        {
            foreach (var (key, value) in properties)
            {
                outgoing.ApplicationProperties[key] = value;
            }

            if (properties.TryGetValue(BusMessage.CorrelationIdProperty, out var correlationId))
            {
                outgoing.CorrelationId = correlationId;
            }

            if (properties.TryGetValue(BusMessage.ReplyToProperty, out var replyTo))
            {
                outgoing.ReplyTo = replyTo;
            }
        }

        await sender.SendMessageAsync(outgoing, cancellationToken);
    }

    public async Task<IAsyncDisposable> SubscribeAsync(string entity, Func<BusMessage, CancellationToken, Task<BusOutcome>> handler, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(entity);
        var parts = entity.Split('/', 2);
        var options = new ServiceBusProcessorOptions { AutoCompleteMessages = false };
        var processor = parts.Length == 2 ? client.CreateProcessor(parts[0], parts[1], options) : client.CreateProcessor(entity, options);
        processor.ProcessMessageAsync += args => SettleAsync(args, parts[0], handler);
        processor.ProcessErrorAsync += args =>
        {
            logger.LogError(args.Exception, "Service Bus error on {EntityPath} from {ErrorSource}", args.EntityPath, args.ErrorSource);
            return Task.CompletedTask;
        };
        await processor.StartProcessingAsync(cancellationToken);
        return new Subscription(processor);
    }

    public Task<BusMessage> RequestAsync<T>(string entity, T message, TimeSpan timeout, CancellationToken cancellationToken = default)
    {
        // Request-reply over Service Bus needs a session-enabled reply queue (design decision).
        throw new NotImplementedException($"agent fills: request-reply on {entity} over Service Bus sessions");
    }

    public Task ReplyAsync<T>(BusMessage request, T message, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(request);
        if (!request.Properties.TryGetValue(BusMessage.ReplyToProperty, out var replyTo))
        {
            throw new InvalidOperationException($"Message on {request.Entity} has no {BusMessage.ReplyToProperty} property.");
        }

        var properties = new Dictionary<string, string>();
        if (request.Properties.TryGetValue(BusMessage.CorrelationIdProperty, out var correlationId))
        {
            properties[BusMessage.CorrelationIdProperty] = correlationId;
        }

        return PublishAsync(replyTo, message, properties, cancellationToken);
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var sender in _senders.Values)
        {
            await sender.DisposeAsync();
        }
    }

    private async Task SettleAsync(ProcessMessageEventArgs args, string entity, Func<BusMessage, CancellationToken, Task<BusOutcome>> handler)
    {
        var received = args.Message;
        var properties = received.ApplicationProperties.ToDictionary(p => p.Key, p => Convert.ToString(p.Value, CultureInfo.InvariantCulture) ?? string.Empty);
        if (!string.IsNullOrEmpty(received.CorrelationId))
        {
            properties[BusMessage.CorrelationIdProperty] = received.CorrelationId;
        }

        if (!string.IsNullOrEmpty(received.ReplyTo))
        {
            properties[BusMessage.ReplyToProperty] = received.ReplyTo;
        }

        BusOutcome outcome;
        try
        {
            outcome = await handler(new BusMessage(entity, received.Body.ToString(), properties), args.CancellationToken);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            logger.LogError(ex, "Transient failure on {Entity} (delivery {DeliveryCount}); message abandoned for redelivery", entity, received.DeliveryCount);
            await args.AbandonMessageAsync(received, cancellationToken: args.CancellationToken);
            return;
        }

        if (outcome.Disposition == BusDisposition.DeadLetter)
        {
            await args.DeadLetterMessageAsync(received, outcome.Reason ?? "DeadLettered", outcome.Description, args.CancellationToken);
        }
        else
        {
            await args.CompleteMessageAsync(received, args.CancellationToken);
        }
    }

    private sealed class Subscription(ServiceBusProcessor processor) : IAsyncDisposable
    {
        public async ValueTask DisposeAsync()
        {
            await processor.StopProcessingAsync();
            await processor.DisposeAsync();
        }
    }
}
