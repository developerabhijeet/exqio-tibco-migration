using System.Globalization;

namespace {{ app }}.Core.Tibco;

/// <summary>
/// A value read from a TIBCO variable path, converted the way an XSLT <c>value-of</c> converts it: to
/// its string form first, then explicitly to the type a mapping needs. Generated code uses it only when
/// the source and target types differ (<c>TibValue.Of(row.Amount).AsString()</c>); every <c>AsX()</c>
/// returns null instead of throwing, and a required target fails visibly with <see cref="Missing"/>.
/// </summary>
public readonly struct TibValue : IEquatable<TibValue>
{
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;
    private readonly object? _value;

    private TibValue(object? value) => _value = value;

    /// <summary>Wraps a source value (null, a string, a number, a date or any formattable value).</summary>
    public static TibValue Of(object? value) => new(value);

    /// <summary>True when the string value is empty (an absent or empty element).</summary>
    public bool IsEmpty => AsString().Length == 0;

    /// <summary>The XPath string value: empty for null, invariant culture for numbers and dates.</summary>
    public string AsString() => _value switch
    {
        null => string.Empty,
        string s => s,
        bool b => b ? "true" : "false",
        DateTime dt => dt.ToString("yyyy-MM-ddTHH:mm:ss.FFFFFFF", Invariant),
        DateTimeOffset dto => dto.ToString("yyyy-MM-ddTHH:mm:ss.FFFFFFFzzz", Invariant),
        DateOnly d => d.ToString("yyyy-MM-dd", Invariant),
        TimeOnly t => t.ToString("HH:mm:ss.FFFFFFF", Invariant),
        IFormattable f => f.ToString(null, Invariant),
        _ => _value.ToString() ?? string.Empty,
    };

    public int? AsInt() => int.TryParse(AsString(), NumberStyles.Integer, Invariant, out var v) ? v : null;

    public long? AsLong() => long.TryParse(AsString(), NumberStyles.Integer, Invariant, out var v) ? v : null;

    public ulong? AsULong() => ulong.TryParse(AsString(), NumberStyles.Integer, Invariant, out var v) ? v : null;

    public decimal? AsDecimal() => decimal.TryParse(AsString(), NumberStyles.Float, Invariant, out var v) ? v : null;

    public double? AsDouble() => double.TryParse(AsString(), NumberStyles.Float, Invariant, out var v) ? v : null;

    public float? AsFloat() => float.TryParse(AsString(), NumberStyles.Float, Invariant, out var v) ? v : null;

    public bool? AsBool() => AsString() switch
    {
        "true" or "1" => true,
        "false" or "0" => false,
        _ => null,
    };

    public DateTime? AsDateTime() => DateTime.TryParse(AsString(), Invariant, DateTimeStyles.RoundtripKind, out var v) ? v : null;

    public DateOnly? AsDateOnly()
    {
        var text = AsString();
        return DateOnly.TryParse(text.Length >= 10 ? text[..10] : text, Invariant, out var v) ? v : null;
    }

    public TimeOnly? AsTimeOnly() => TimeOnly.TryParse(AsString(), Invariant, out var v) ? v : null;

    /// <summary>The error for a required target whose TIBCO value is empty or does not convert.</summary>
    public static FormatException Missing(string field) =>
        new($"The TIBCO mapping produced no valid value for the required field '{field}'.");

    public bool Equals(TibValue other) => string.Equals(AsString(), other.AsString(), StringComparison.Ordinal);

    public override bool Equals(object? obj) => obj is TibValue other && Equals(other);

    public override int GetHashCode() => StringComparer.Ordinal.GetHashCode(AsString());

    public static bool operator ==(TibValue left, TibValue right) => left.Equals(right);

    public static bool operator !=(TibValue left, TibValue right) => !left.Equals(right);

    public override string ToString() => AsString();
}
