using {{ app }}.Api.Errors;
using {{ app }}.Infrastructure;
using {{ app }}.Infrastructure.Messaging;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.OpenApi.Models;
#if EXIQO_DEV_ENDPOINTS
using {{ app }}.Api.Auth;
#endif

var builder = WebApplication.CreateBuilder(args);

// Auth:Mode=Development issues and accepts a development JWT (POST /auth/dev-token);
// Auth:Mode=Production validates Microsoft Entra ID tokens (Auth:EntraId settings).
var authMode = builder.Configuration["Auth:Mode"] ?? "Production";
var devAuth = string.Equals(authMode, "Development", StringComparison.OrdinalIgnoreCase);
if (devAuth && builder.Environment.IsProduction())
{
    throw new InvalidOperationException("Auth:Mode=Development is refused in the Production environment.");
}

builder.Services.AddControllers();
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen(options =>
{
    options.SwaggerDoc("v1", new OpenApiInfo { Title = "{{ title }}", Version = "v1", Description = "Generated by ExiQO Migrate from TIBCO BusinessWorks application {{ app_id }}." });
    options.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme
    {
        Type = SecuritySchemeType.Http,
        Scheme = "bearer",
        BearerFormat = "JWT",
        Description = "Development: POST /auth/dev-token. Production: a Microsoft Entra ID access token.",
    });
    options.AddSecurityRequirement(new OpenApiSecurityRequirement
    {
        [new OpenApiSecurityScheme { Reference = new OpenApiReference { Type = ReferenceType.SecurityScheme, Id = "Bearer" } }] = Array.Empty<string>(),
    });
});
builder.Services.AddProblemDetails();
builder.Services.AddExceptionHandler<FaultExceptionHandler>();
builder.Services.AddHealthChecks();
builder.Services.Add{{ app }}Infrastructure(builder.Configuration);
builder.Services.AddAuthorization();

var authentication = builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme);
if (devAuth)
{
#if EXIQO_DEV_ENDPOINTS
    authentication.AddJwtBearer(options => options.TokenValidationParameters = DevToken.ValidationParameters(builder.Configuration));
#else
    throw new InvalidOperationException("Auth:Mode=Development is compiled out of Release builds.");
#endif
}
else
{
    authentication.AddJwtBearer(options =>
    {
        var entra = builder.Configuration.GetSection("Auth:EntraId");
        options.Authority = $"{entra["Instance"]}{entra["TenantId"]}/v2.0";
        options.Audience = entra["Audience"];
    });
}

var app = builder.Build();

app.UseExceptionHandler();
app.UseSwagger();
app.UseSwaggerUI();
app.UseAuthentication();
app.UseAuthorization();

app.MapControllers().RequireAuthorization();
app.MapHealthChecks("/health").AllowAnonymous();

#if EXIQO_DEV_ENDPOINTS
if (devAuth)
{
    // Development only: a signed JWT for Swagger and the verifier.
    app.MapPost("/auth/dev-token", (DevTokenRequest? request, IConfiguration configuration) =>
        Results.Ok(DevToken.Issue(configuration, request?.Subject ?? "exiqo-verifier"))).AllowAnonymous();

    // Development only: drive JMS-started workflows through the in-memory bus and read what was published.
    var bus = app.Services.GetService<InMemoryMessageBus>();
    if (bus is not null)
    {
        app.MapPost("/_bus/publish", async (BusPublishRequest request, CancellationToken cancellationToken) =>
        {
            await bus.DeliverAsync(request.ToMessage(), cancellationToken);
            return Results.Accepted();
        }).RequireAuthorization();
        app.MapGet("/_bus/messages", (string? entity) =>
            Results.Ok(entity is null ? bus.Published : bus.PublishedTo(entity))).RequireAuthorization();
    }
}
#endif

app.Run();

