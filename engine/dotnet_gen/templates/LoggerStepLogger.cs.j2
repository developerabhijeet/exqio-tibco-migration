using {{ app }}.Core.Diagnostics;
using Microsoft.Extensions.Logging;

namespace {{ app }}.Infrastructure.Diagnostics;

/// <summary>TIBCO Log activity on ILogger: one structured entry per step, level from <c>logLevel</c>.</summary>
public sealed class LoggerStepLogger(ILogger<LoggerStepLogger> logger) : IStepLogger
{
    public void Write(string process, string step, StepLogEntry entry)
    {
        ArgumentNullException.ThrowIfNull(entry);
        var level = entry.LogLevel?.ToUpperInvariant() switch
        {
            "ERROR" => LogLevel.Error,
            "WARN" or "WARNING" => LogLevel.Warning,
            "DEBUG" => LogLevel.Debug,
            "TRACE" => LogLevel.Trace,
            _ => LogLevel.Information,
        };
        logger.Log(level, "{Process} {Step} {MsgCode} {Message}", process, step, entry.MsgCode, entry.Message);
    }
}
