<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Generated by ExiQO Migrate. ASP.NET Core host: controllers, Swagger, authentication, health. -->
  <PropertyGroup>
    <RootNamespace>{{ app }}.Api</RootNamespace>
    <UserSecretsId>exiqo-{{ app_lower }}</UserSecretsId>
  </PropertyGroup>
  <!-- The development token and bus endpoints are compiled out of Release builds (production images). -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);EXIQO_DEV_ENDPOINTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\{{ app }}.Core\{{ app }}.Core.csproj" />
    <ProjectReference Include="..\{{ app }}.Infrastructure\{{ app }}.Infrastructure.csproj" />
  </ItemGroup>
</Project>
