    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:complexType block="extension restriction"
                final="extension restriction" name="ErrorReport">
                <xs:sequence>
                    <xs:element form="unqualified" name="StackTrace" type="xs:string"/>
                    <xs:element form="unqualified" name="Msg" type="xs:string"/>
                    <xs:element form="unqualified" name="FullClass" type="xs:string"/>
                    <xs:element form="unqualified" name="Class" type="xs:string"/>
                    <xs:element form="unqualified" name="ProcessStack" type="xs:string"/>
                    <xs:element form="unqualified" minOccurs="0" name="MsgCode" type="xs:string"/>
                    <xs:element form="unqualified" minOccurs="0" name="Data" type="tns:anydata"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType block="extension restriction"
                final="extension restriction" name="FaultDetail">
                <xs:sequence>
                    <xs:element form="unqualified" name="ActivityName" type="xs:string"/>
                    <xs:element form="unqualified" minOccurs="0" name="Data" type="tns:anydata"/>
                    <xs:element form="unqualified" name="Msg" type="xs:string"/>
                    <xs:element form="unqualified" name="MsgCode" type="xs:string"/>
                    <xs:element form="unqualified" name="ProcessStack" type="xs:string"/>
                    <xs:element form="unqualified" name="StackTrace" type="xs:string"/>
                    <xs:element form="unqualified" name="FullClass" type="xs:string"/>
                    <xs:element form="unqualified" name="Class" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType block="extension restriction"
                final="extension restriction" name="ProcessContext">
                <xs:sequence>
                    <xs:element form="unqualified" name="JobId" type="xs:string"/>
                    <xs:element form="unqualified" name="ApplicationName" type="xs:string"/>
                    <xs:element form="unqualified" name="EngineName" type="xs:string"/>
                    <xs:element form="unqualified" name="ProcessInstanceId" type="xs:string"/>
                    <xs:element form="unqualified" minOccurs="0" name="CustomJobId" type="xs:string"/>
                    <xs:element form="unqualified" minOccurs="0" name="TrackingInfo" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="anydata">
                <xs:sequence>
                    <xs:any namespace="##any" processContents="lax"/>
                </xs:sequence>
            </xs:complexType>
            <xs:element name="ErrorReport" type="tns:ErrorReport"/>
            <xs:element name="FaultDetail" type="tns:FaultDetail"/>
            <xs:element name="ProcessContext" type="tns:ProcessContext"/>
            <xs:element name="CorrelationValue" type="xs:string"/>
        </xs:schema>
        <wsdl:definitions
            targetNamespace="http://xmlns.example.com/20200615113902PLT"
            xmlns:extns="http://tns.tibco.com/bw/REST"
            xmlns:extns2="http://xmlns.example.com/accounts/parameters"
            xmlns:extns3="http://xmlns.gmfin.example/loan/servicing/account"
            xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype"
            xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
            xmlns:tns="http://xmlns.example.com/20200615113902PLT"
            xmlns:vprop="http://docs.oasis-open.org/wsbpel/2.0/varprop"
            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="tns:accounts"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://tns.tibco.com/bw/REST"/>
            <wsdl:import namespace="http://xmlns.example.com/accounts/parameters"/>
            <wsdl:import namespace="http://xmlns.gmfin.example/loan/servicing/account"/>
            <wsdl:message name="getRequest">
                <wsdl:part element="extns2:accountsGetParameters"
                    name="parameters" tibex:source="bw.rest"/>
                <wsdl:part element="extns:httpHeaders"
                    name="httpHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="getResponse">
                <wsdl:part element="extns3:AccountSummary"
                    name="item" tibex:hasMultipleNamespaces="false"/>
            </wsdl:message>
            <wsdl:message name="get4XXFaultMessage">
                <wsdl:part element="extns:client4XXError" name="clientError"/>
            </wsdl:message>
            <wsdl:message name="get5XXFaultMessage">
                <wsdl:part element="extns:server5XXError" name="serverError"/>
            </wsdl:message>
            <wsdl:portType name="accounts"
                tibex:bw.rest.apipath="/accounts/{accountNumber}"
                tibex:bw.rest.basepath="Accounts"
                tibex:bw.rest.resource="Service Descriptors/loanservicing.AccountLookup-accounts.json"
                tibex:bw.rest.resource.source="generated" tibex:source="bw.rest.service">
                <wsdl:documentation>Loan account summary.</wsdl:documentation>
                <wsdl:operation name="get">
                    <wsdl:input message="tns:getRequest" name="getInput"/>
                    <wsdl:output message="tns:getResponse" name="getOutput"/>
                    <wsdl:fault message="tns:get4XXFaultMessage" name="clientFault"/>
                    <wsdl:fault message="tns:get5XXFaultMessage" name="serverFault"/>
                </wsdl:operation>
            </wsdl:portType>
        </wsdl:definitions>
        <schema elementFormDefault="unqualified"
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+438307cf-96ba-589c-91af-ac753b336e24+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+438307cf-96ba-589c-91af-ac753b336e24+input">
            <element name="jdbcQueryActivityInput">
                <complexType>
                    <sequence>
                        <element name="accountNumber" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema elementFormDefault="unqualified"
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+438307cf-96ba-589c-91af-ac753b336e24+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+438307cf-96ba-589c-91af-ac753b336e24+output">
            <complexType name="RecordType">
                <sequence>
                    <element minOccurs="0" name="account_number" type="string"/>
                    <element minOccurs="0" name="principal_balance" type="decimal"/>
                    <element minOccurs="0" name="next_due_date" type="date"/>
                    <element minOccurs="0" name="days_past_due" type="int"/>
                    <element minOccurs="0" name="status" type="string"/>
                    <element minOccurs="0" name="first_name" type="string"/>
                    <element minOccurs="0" name="last_name" type="string"/>
                    <element minOccurs="0" name="ssn" type="string"/>
                </sequence>
            </complexType>
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record" type="tns:RecordType"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
    </tibex:Types>
    <tibex:ProcessInfo callable="false" createdBy="bwdev01"
