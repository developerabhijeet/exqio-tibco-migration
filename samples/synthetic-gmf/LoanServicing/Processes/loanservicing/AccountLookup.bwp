    <tibex:NamespaceRegistry enabled="true">
        <tibex:namespaceItem namespace="http://xmlns.example.com/accounts/parameters"
            prefix="tns"/>
        <tibex:namespaceItem namespace="http://xmlns.gmfin.example/loan/servicing/account"
            prefix="tns1"/>
        <tibex:namespaceItem namespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+438307cf-96ba-589c-91af-ac753b336e24+input"
            prefix="tns2"/>
        <tibex:namespaceItem namespace="http://tns.tibco.com/bw/REST"
            prefix="tns3"/>
        <tibex:namespaceItem namespace="http://xmlns.example.com/20200615113902PLT"
            prefix="tns4"/>
    </tibex:NamespaceRegistry>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        namespace="http://tns.tibco.com/bw/REST"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        namespace="http://xmlns.example.com/accounts/parameters"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        namespace="http://xmlns.gmfin.example/loan/servicing/account"/>
    <bpws:partnerLinks>
        <bpws:partnerLink myRole="use" name="accounts"
            partnerLinkType="ns0:partnerLinkType" sca-bpel:ignore="false"
            sca-bpel:service="accounts"/>
    </bpws:partnerLinks>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext" name="_processContext"
            sca-bpel:internal="true"/>
        <bpws:variable messageType="ns0:getRequest" name="get"
            sca-bpel:internal="true"/>
        <bpws:variable messageType="ns0:getResponse" name="getOut-input"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error"
            sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>loanservicing.GMFServicingDB</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="QueryAccount-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="QueryAccount"
            sca-bpel:internal="true"/>
        <bpws:variable messageType="ns0:get4XXFaultMessage"
            name="ReplyAccountNotFound-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no"
            namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no"
            namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no"
            namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no"
            namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no"
            namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no"
            namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick"
                tibex:xpdlId="bb5f7a73-dffc-553c-8a9e-f94aafdf266b">
                <bpws:onMessage operation="get" partnerLink="accounts"
                    portType="ns0:accounts"
                    tibex:xpdlId="3a091046-c752-5f77-a778-a2acf00ed9d1"
                    variable="get">
                    <bpws:scope name="scope1">
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="QueryAccountTogetOut"
                                    tibex:label="Found"
                                    tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="QueryAccountToReplyAccountNotFound"
                                    tibex:label=""
                                    tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart"
                                tibex:constructor="onMessageStart"
                                tibex:xpdlId="a567f6fe-4c3b-5919-b1e1-0f4c344b8e50"/>
                            <bpws:empty name="OnMessageEnd"
                                tibex:constructor="onMessageEnd"
                                tibex:xpdlId="bc0b0be7-08cc-524c-8cbc-15683e104c3c"/>
                            <bpws:extensionActivity>
                                <tibex:activityExtension inputVariable="QueryAccount-input"
                                    name="QueryAccount"
                                    outputVariable="QueryAccount"
                                    tibex:xpdlId="438307cf-96ba-589c-91af-ac753b336e24"
                                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                        <bpws:source linkName="QueryAccountTogetOut">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="count($QueryAccount/Record) > 0"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($QueryAccount/Record) > 0]]></bpws:transitionCondition>
                                        </bpws:source>
                                        <bpws:source linkName="QueryAccountToReplyAccountNotFound">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="##otherwise##"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                        </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/accounts/parameters&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+438307cf-96ba-589c-91af-ac753b336e24+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryAccount-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;accountNumber>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns:accountNumber&quot;/>&#xa;            &lt;/accountNumber>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                        <bwext:BWActivity activityTypeID="bw.jdbc.JDBCQuery"
                                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                            <activityConfig>
                                                <properties name="config"
                                                    xsi:type="activityconfig:EMFProperty">
                                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                                    <value maxRows="100"
                                                        sharedResourceProperty="jdbcProperty"
                                                        sqlStatement="select la.account_number, la.principal_balance, la.next_due_date, la.days_past_due, la.status,&#xa;       a.first_name, a.last_name, a.ssn&#xa;  from gmf.loan_account la&#xa;  join gmf.applicant a on a.applicant_id = la.applicant_id&#xa; where la.account_number = ?"
                                                        timeout="10"
                                                        xsi:type="jdbcPalette:JDBCQueryActivity">
                                                        <PreparedParameters DataType="12"
                                                            DataTypeDisplayValue="VARCHAR"
                                                            ParameterName="accountNumber"/>
                                                        <columnMetadata columnName="account_number"
                                                            dataType="12"
                                                            status="OptionalElement"
                                                            typeName="varchar"/>
                                                        <columnMetadata columnName="principal_balance"
                                                            dataType="2"
                                                            status="OptionalElement"
                                                            typeName="numeric"/>
                                                        <columnMetadata columnName="next_due_date"
                                                            dataType="91"
                                                            status="OptionalElement"
                                                            typeName="date"/>
                                                        <columnMetadata columnName="days_past_due"
                                                            dataType="4"
                                                            status="OptionalElement"
                                                            typeName="int4"/>
                                                        <columnMetadata columnName="status"
                                                            dataType="12"
                                                            status="OptionalElement"
                                                            typeName="varchar"/>
                                                        <columnMetadata columnName="first_name"
                                                            dataType="12"
                                                            status="OptionalElement"
                                                            typeName="varchar"/>
                                                        <columnMetadata columnName="last_name"
                                                            dataType="12"
                                                            status="OptionalElement"
                                                            typeName="varchar"/>
                                                        <columnMetadata columnName="ssn"
                                                            dataType="12"
                                                            status="OptionalElement"
                                                            typeName="varchar"/>
                                                    </value>
                                                </properties>
                                            </activityConfig>
                                        </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:reply name="getOut" operation="get"
                                partnerLink="accounts" portType="ns0:accounts"
                                tibex:xpdlId="8df90c02-ca76-530c-a913-98e3d645a9c9"
                                variable="getOut-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.gmfin.example/loan/servicing/account&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;QueryAccount&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:AccountSummary>&#xa;            &lt;tns1:accountNumber>&#xa;                &lt;xsl:value-of select=&quot;$QueryAccount/Record[1]/account_number&quot;/>&#xa;            &lt;/tns1:accountNumber>&#xa;            &lt;tns1:borrowerName>&#xa;                &lt;xsl:value-of select=&quot;concat($QueryAccount/Record[1]/first_name, ' ', $QueryAccount/Record[1]/last_name)&quot;/>&#xa;            &lt;/tns1:borrowerName>&#xa;            &lt;tns1:maskedSsn>&#xa;                &lt;xsl:value-of select=&quot;concat('***-**-', substring($QueryAccount/Record[1]/ssn, 8, 4))&quot;/>&#xa;            &lt;/tns1:maskedSsn>&#xa;            &lt;tns1:principalBalance>&#xa;                &lt;xsl:value-of select=&quot;$QueryAccount/Record[1]/principal_balance&quot;/>&#xa;            &lt;/tns1:principalBalance>&#xa;            &lt;tns1:nextDueDate>&#xa;                &lt;xsl:value-of select=&quot;$QueryAccount/Record[1]/next_due_date&quot;/>&#xa;            &lt;/tns1:nextDueDate>&#xa;            &lt;tns1:daysPastDue>&#xa;                &lt;xsl:value-of select=&quot;$QueryAccount/Record[1]/days_past_due&quot;/>&#xa;            &lt;/tns1:daysPastDue>&#xa;            &lt;tns1:status>&#xa;                &lt;xsl:value-of select=&quot;$QueryAccount/Record[1]/status&quot;/>&#xa;            &lt;/tns1:status>&#xa;        &lt;/tns1:AccountSummary>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.gmfin.example/loan/servicing/account" xmlns:tns4="http://xmlns.example.com/20200615113902PLT" version="2.0"&gt;&lt;xsl:param name="QueryAccount"/&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns4:getResponse&gt;&lt;item&gt;&lt;tns1:AccountSummary&gt;&lt;tns1:accountNumber&gt;&lt;xsl:value-of select="$QueryAccount/Record[1]/account_number"/&gt;&lt;/tns1:accountNumber&gt;&lt;tns1:borrowerName&gt;&lt;xsl:value-of select="concat($QueryAccount/Record[1]/first_name, ' ', $QueryAccount/Record[1]/last_name)"/&gt;&lt;/tns1:borrowerName&gt;&lt;tns1:maskedSsn&gt;&lt;xsl:value-of select="concat('***-**-', substring($QueryAccount/Record[1]/ssn, 8, 4))"/&gt;&lt;/tns1:maskedSsn&gt;&lt;tns1:principalBalance&gt;&lt;xsl:value-of select="$QueryAccount/Record[1]/principal_balance"/&gt;&lt;/tns1:principalBalance&gt;&lt;tns1:nextDueDate&gt;&lt;xsl:value-of select="$QueryAccount/Record[1]/next_due_date"/&gt;&lt;/tns1:nextDueDate&gt;&lt;tns1:daysPastDue&gt;&lt;xsl:value-of select="$QueryAccount/Record[1]/days_past_due"/&gt;&lt;/tns1:daysPastDue&gt;&lt;tns1:status&gt;&lt;xsl:value-of select="$QueryAccount/Record[1]/status"/&gt;&lt;/tns1:status&gt;&lt;/tns1:AccountSummary&gt;&lt;/item&gt;&lt;/tns4:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="QueryAccountTogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:reply faultName="clientFault"
                                name="ReplyAccountNotFound" operation="get"
                                partnerLink="accounts" portType="ns0:accounts"
                                tibex:xpdlId="d8428e83-168f-5c36-8cf7-fba5709169f4"
                                variable="ReplyAccountNotFound-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ReplyAccountNotFound-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:client4XXError>&#xa;            &lt;statusCode>&#xa;                &lt;xsl:value-of select=&quot;404&quot;/>&#xa;            &lt;/statusCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Account not found&amp;quot;&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns3:client4XXError>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://tns.tibco.com/bw/REST" xmlns:tns4="http://xmlns.example.com/20200615113902PLT" version="2.0"&gt;&lt;xsl:template name="ReplyAccountNotFound-input" match="/"&gt;&lt;tns4:get4XXFaultMessage&gt;&lt;clientError&gt;&lt;tns3:client4XXError&gt;&lt;statusCode&gt;&lt;xsl:value-of select="404"/&gt;&lt;/statusCode&gt;&lt;message&gt;&lt;xsl:value-of select="&amp;quot;Account not found&amp;quot;"/&gt;&lt;/message&gt;&lt;/tns3:client4XXError&gt;&lt;/clientError&gt;&lt;/tns4:get4XXFaultMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="QueryAccountToReplyAccountNotFound"/>
                                </bpws:targets>
                            </bpws:reply>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
