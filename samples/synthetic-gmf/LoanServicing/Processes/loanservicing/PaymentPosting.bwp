        <schema elementFormDefault="unqualified"
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jms+2a8d1ffe-17e9-5d10-a980-b2879089ad54+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:body="http://xmlns.gmfin.example/loan/servicing/payment" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jms+2a8d1ffe-17e9-5d10-a980-b2879089ad54+output">
            <import namespace="http://xmlns.gmfin.example/loan/servicing/payment"/>
            <complexType name="JMSHeadersType">
                <sequence>
                    <element minOccurs="0" name="JMSDestination" type="string"/>
                    <element minOccurs="0" name="JMSReplyTo" type="string"/>
                    <element minOccurs="0" name="JMSDeliveryMode" type="string"/>
                    <element minOccurs="0" name="JMSMessageID" type="string"/>
                    <element minOccurs="0" name="JMSTimestamp" type="long"/>
                    <element minOccurs="0" name="JMSExpiration" type="long"/>
                    <element minOccurs="0" name="JMSRedelivered" type="boolean"/>
                    <element minOccurs="0" name="JMSPriority" type="int"/>
                    <element minOccurs="0" name="JMSCorrelationID" type="string"/>
                    <element minOccurs="0" name="JMSType" type="string"/>
                </sequence>
            </complexType>
            <element name="ActivityOutput">
                <complexType>
                    <sequence>
                        <element minOccurs="0" name="JMSHeaders" type="tns:JMSHeadersType"/>
                        <element minOccurs="0" name="JMSProperties">
                            <complexType>
                                <sequence>
                                    <element minOccurs="0" name="JMSXDeliveryCount" type="int"/>
                                </sequence>
                            </complexType>
                        </element>
                        <element minOccurs="0" name="Body">
                            <complexType>
                                <sequence>
                                    <element ref="body:Payment"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema elementFormDefault="unqualified"
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+0175997e-5ee6-57b7-9d4b-5ef36f65cd22+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+0175997e-5ee6-57b7-9d4b-5ef36f65cd22+input">
            <element name="jdbcQueryActivityInput">
                <complexType>
                    <sequence>
                        <element name="accountNumber" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema elementFormDefault="unqualified"
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+0175997e-5ee6-57b7-9d4b-5ef36f65cd22+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+0175997e-5ee6-57b7-9d4b-5ef36f65cd22+output">
            <complexType name="RecordType">
                <sequence>
                    <element minOccurs="0" name="account_number" type="string"/>
                    <element minOccurs="0" name="fees_due" type="decimal"/>
                    <element minOccurs="0" name="accrued_interest" type="decimal"/>
                    <element minOccurs="0" name="principal_balance" type="decimal"/>
                    <element minOccurs="0" name="next_due_date" type="date"/>
                    <element minOccurs="0" name="status" type="string"/>
                </sequence>
            </complexType>
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record" type="tns:RecordType"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema elementFormDefault="unqualified"
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+9fc69bae-c4c7-542f-a4a1-1bf9d0e8160a+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+9fc69bae-c4c7-542f-a4a1-1bf9d0e8160a+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element minOccurs="0" name="paymentId" type="string"/>
                        <element minOccurs="0" name="accountNumber" type="string"/>
                        <element minOccurs="0" name="amount" type="decimal"/>
                        <element minOccurs="0" name="channel" type="string"/>
                        <element minOccurs="0" name="receivedDate" type="date"/>
                        <element minOccurs="0" name="feeApplied" type="decimal"/>
                        <element minOccurs="0" name="lateFeeApplied" type="decimal"/>
                        <element minOccurs="0" name="interestApplied" type="decimal"/>
                        <element minOccurs="0" name="principalApplied" type="decimal"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="unqualified"
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc"
            xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:element name="jdbcUpdateActivityOutput">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="noOfUpdates" type="xs:int"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
        <schema elementFormDefault="unqualified"
