                        <element minOccurs="0" name="accruedInterest" type="decimal"/>
                        <element minOccurs="0" name="principalBalance" type="decimal"/>
                        <element minOccurs="0" name="lastPaymentDate" type="date"/>
                        <element minOccurs="0" name="accountNumber" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <xs:schema attributeFormDefault="unqualified"
