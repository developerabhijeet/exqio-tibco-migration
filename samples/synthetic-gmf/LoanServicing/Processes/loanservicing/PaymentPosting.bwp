    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        namespace="http://xmlns.gmfin.example/loan/servicing/payment"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext" name="_processContext"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error"
            sca-bpel:internal="true"/>
        <bpws:variable name="jmsConnection" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/bw/models/sharedresource/jms}JMSConnectionFactory"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>loanservicing.GMFEMSConnection</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>loanservicing.GMFServicingDB</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns0:ActivityOutput" name="ReceivePayment"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="LoadAccount-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="LoadAccount"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns3:LateFeeAssessment"
            name="AssessLateFee-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:LateFeeAssessment" name="AssessLateFee"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns3:LateFeeAssessment" name="NoLateFee-input"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns3:LateFeeAssessment" name="NoLateFee"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns3:PaymentAllocation"
            name="AllocatePayment-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:PaymentAllocation" name="AllocatePayment"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns4:jdbcUpdateActivityInput"
            name="InsertPayment-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcUpdateActivityOutput"
            name="InsertPayment" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:jdbcUpdateActivityInput"
            name="UpdateLoanAccount-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcUpdateActivityOutput"
            name="UpdateLoanAccount" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:ActivityInput" name="LogPaymentPosted-input"
            sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no"
            namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no"
            namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no"
