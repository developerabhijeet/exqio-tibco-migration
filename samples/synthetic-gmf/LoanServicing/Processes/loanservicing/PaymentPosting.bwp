        <bpws:extension mustUnderstand="no"
            namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="ReceivePaymentToPostPaymentTransaction"
                    tibex:linkType="SUCCESS"/>
                <bpws:link name="PostPaymentTransactionToLogPaymentPosted"
                    tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes" eventTimeout="60"
                    name="ReceivePayment"
                    tibex:xpdlId="2a8d1ffe-17e9-5d10-a980-b2879089ad54"
                    variable="ReceivePayment"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="ReceivePaymentToPostPaymentTransaction"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity activityTypeID="bw.jms.receive"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSReceiveMessage"/>
                                    <value acknowledgeMode="1"
                                        connectionReference="jmsConnection"
                                        destination="gmf.payments.inbound"
                                        messageSelector="PaymentChannel IN ('ACH', 'DEBIT', 'LOCKBOX')"
                                        messageType="XMLText"
                                        messagingStyle="Queue"
                                        pollingInterval="2"
                                        xsi:type="jms:JMSReceiveMessage">
                                        <bodyEditorElement href="platform:/resource/LoanServicing/Schemas/Payment.xsd#//Payment;XSDElementDeclaration"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:scope name="PostPaymentTransaction"
                tibex:group="localTransaction"
                tibex:xpdlId="03f4d9d4-cc15-5a90-9eff-cde315f1bdf9">
                <bpws:targets>
                    <bpws:target linkName="ReceivePaymentToPostPaymentTransaction"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="PostPaymentTransactionToLogPaymentPosted"/>
                </bpws:sources>
                <bpws:flow name="flow1">
                    <bpws:links>
                        <bpws:link name="GroupStartToLoadAccount"
                            tibex:linkType="SUCCESS"/>
                        <bpws:link name="LoadAccountToAssessLateFee"
                            tibex:label="Past 10-day grace"
                            tibex:linkType="SUCCESSWITHCONDITION"/>
                        <bpws:link name="LoadAccountToNoLateFee" tibex:label=""
                            tibex:linkType="SUCCESSWITHNOCONDITION"/>
                        <bpws:link name="AssessLateFeeToAllocatePayment"
                            tibex:linkType="SUCCESS"/>
                        <bpws:link name="NoLateFeeToAllocatePayment"
                            tibex:linkType="SUCCESS"/>
                        <bpws:link name="AllocatePaymentToInsertPayment"
                            tibex:linkType="SUCCESS"/>
                        <bpws:link name="InsertPaymentToUpdateLoanAccount"
                            tibex:linkType="SUCCESS"/>
                        <bpws:link name="UpdateLoanAccountToGroupEnd"
                            tibex:linkType="SUCCESS"/>
                    </bpws:links>
                    <bpws:empty name="GroupStart" tibex:group="groupStart"
                        tibex:xpdlId="5d0db2c7-4263-585b-96ff-ca03062661c2">
                        <bpws:sources>
                            <bpws:source linkName="GroupStartToLoadAccount"/>
                        </bpws:sources>
                    </bpws:empty>
                    <bpws:extensionActivity>
                        <tibex:activityExtension inputVariable="LoadAccount-input"
                            name="LoadAccount" outputVariable="LoadAccount"
                            tibex:xpdlId="0175997e-5ee6-57b7-9d4b-5ef36f65cd22"
                            xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="GroupStartToLoadAccount"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="LoadAccountToAssessLateFee">
                                    <tibex:DesignExpression>
                                        <tibex:expression expression="days-from-duration(xsd:date($ReceivePayment/Body/tns:Payment/tns:receivedDate) - xsd:date($LoadAccount/Record[1]/next_due_date)) >= 10"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[days-from-duration(xsd:date($ReceivePayment/Body/tns:Payment/tns:receivedDate) - xsd:date($LoadAccount/Record[1]/next_due_date)) >= 10]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="LoadAccountToNoLateFee">
                                    <tibex:DesignExpression>
                                        <tibex:expression expression="##otherwise##"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/loan/servicing/payment&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0175997e-5ee6-57b7-9d4b-5ef36f65cd22+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceivePayment&quot;/>&#xa;    &lt;xsl:template name=&quot;LoadAccount-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;accountNumber>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:accountNumber&quot;/>&#xa;            &lt;/accountNumber>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                        <properties name="config"
                                            xsi:type="activityconfig:EMFProperty">
                                            <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                            <value maxRows="100"
                                                sharedResourceProperty="jdbcProperty"
                                                sqlStatement="select account_number, fees_due, accrued_interest, principal_balance, next_due_date, status&#xa;  from gmf.loan_account&#xa; where account_number = ?&#xa;   for update"
                                                timeout="10"
                                                xsi:type="jdbcPalette:JDBCQueryActivity">
                                                <PreparedParameters DataType="12"
                                                    DataTypeDisplayValue="VARCHAR"
                                                    ParameterName="accountNumber"/>
                                                <columnMetadata columnName="account_number"
                                                    dataType="12"
                                                    status="OptionalElement"
                                                    typeName="varchar"/>
                                                <columnMetadata columnName="fees_due"
                                                    dataType="2"
                                                    status="OptionalElement"
                                                    typeName="numeric"/>
                                                <columnMetadata columnName="accrued_interest"
                                                    dataType="2"
                                                    status="OptionalElement"
                                                    typeName="numeric"/>
                                                <columnMetadata columnName="principal_balance"
                                                    dataType="2"
                                                    status="OptionalElement"
                                                    typeName="numeric"/>
                                                <columnMetadata columnName="next_due_date"
                                                    dataType="91"
                                                    status="OptionalElement"
                                                    typeName="date"/>
                                                <columnMetadata columnName="status"
                                                    dataType="12"
                                                    status="OptionalElement"
                                                    typeName="varchar"/>
                                            </value>
                                        </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension inputVariable="AssessLateFee-input"
                            name="AssessLateFee" outputVariable="AssessLateFee"
                            tibex:xpdlId="206069d7-b68d-5829-be01-b1feb71ce092"
                            xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="LoadAccountToAssessLateFee"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="AssessLateFeeToAllocatePayment"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/loan/servicing/payment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceivePayment&quot;/>&#xa;    &lt;xsl:param name=&quot;LoadAccount&quot;/>&#xa;    &lt;xsl:template name=&quot;AssessLateFee-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:LateFeeAssessment>&#xa;            &lt;tns:lateFee>&#xa;                &lt;xsl:value-of select=&quot;25.00&quot;/>&#xa;            &lt;/tns:lateFee>&#xa;            &lt;tns:daysLate>&#xa;                &lt;xsl:value-of select=&quot;days-from-duration(xsd:date($ReceivePayment/Body/tns:Payment/tns:receivedDate) - xsd:date($LoadAccount/Record[1]/next_due_date))&quot;/>&#xa;            &lt;/tns:daysLate>&#xa;        &lt;/tns:LateFeeAssessment>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:ns3="http://xmlns.gmfin.example/loan/servicing/payment"
                                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                        <properties name="config"
                                            xsi:type="activityconfig:EMFProperty">
                                            <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                            <value inputQName="ns3:LateFeeAssessment"
                                                xsi:type="generalactivities:Mapper"/>
                                        </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension inputVariable="NoLateFee-input"
                            name="NoLateFee" outputVariable="NoLateFee"
                            tibex:xpdlId="80727a3d-9fb4-5bc9-b0ef-9c5c99c1f691"
                            xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="LoadAccountToNoLateFee"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="NoLateFeeToAllocatePayment"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/loan/servicing/payment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceivePayment&quot;/>&#xa;    &lt;xsl:param name=&quot;LoadAccount&quot;/>&#xa;    &lt;xsl:template name=&quot;NoLateFee-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:LateFeeAssessment>&#xa;            &lt;tns:lateFee>&#xa;                &lt;xsl:value-of select=&quot;0.00&quot;/>&#xa;            &lt;/tns:lateFee>&#xa;            &lt;tns:daysLate>&#xa;                &lt;xsl:value-of select=&quot;max((0, days-from-duration(xsd:date($ReceivePayment/Body/tns:Payment/tns:receivedDate) - xsd:date($LoadAccount/Record[1]/next_due_date))))&quot;/>&#xa;            &lt;/tns:daysLate>&#xa;        &lt;/tns:LateFeeAssessment>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:ns3="http://xmlns.gmfin.example/loan/servicing/payment"
                                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                        <properties name="config"
                                            xsi:type="activityconfig:EMFProperty">
                                            <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                            <value inputQName="ns3:LateFeeAssessment"
                                                xsi:type="generalactivities:Mapper"/>
                                        </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension inputVariable="AllocatePayment-input"
                            name="AllocatePayment"
                            outputVariable="AllocatePayment"
                            tibex:xpdlId="4153689b-f650-5890-a8c1-282597e938d6"
                            xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="AssessLateFeeToAllocatePayment"/>
                                <bpws:target linkName="NoLateFeeToAllocatePayment"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="AllocatePaymentToInsertPayment"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/loan/servicing/payment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceivePayment&quot;/>&#xa;    &lt;xsl:param name=&quot;LoadAccount&quot;/>&#xa;    &lt;xsl:param name=&quot;AssessLateFee&quot;/>&#xa;    &lt;xsl:param name=&quot;NoLateFee&quot;/>&#xa;    &lt;xsl:template name=&quot;AllocatePayment-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:variable name=&quot;amount&quot; select=&quot;xsd:decimal($ReceivePayment/Body/tns:Payment/tns:amount)&quot;/>&#xa;        &lt;xsl:variable name=&quot;lateFee&quot; select=&quot;xsd:decimal(($AssessLateFee, $NoLateFee)[1]/tns:lateFee)&quot;/>&#xa;        &lt;xsl:variable name=&quot;fees&quot; select=&quot;xsd:decimal($LoadAccount/Record[1]/fees_due) + $lateFee&quot;/>&#xa;        &lt;xsl:variable name=&quot;interest&quot; select=&quot;xsd:decimal($LoadAccount/Record[1]/accrued_interest)&quot;/>&#xa;        &lt;xsl:variable name=&quot;feeApplied&quot; select=&quot;min(($amount, $fees))&quot;/>&#xa;        &lt;xsl:variable name=&quot;interestApplied&quot; select=&quot;min(($amount - $feeApplied, $interest))&quot;/>&#xa;        &lt;xsl:variable name=&quot;principalApplied&quot; select=&quot;$amount - $feeApplied - $interestApplied&quot;/>&#xa;        &lt;tns:PaymentAllocation>&#xa;            &lt;tns:feeApplied>&#xa;                &lt;xsl:value-of select=&quot;$feeApplied&quot;/>&#xa;            &lt;/tns:feeApplied>&#xa;            &lt;tns:lateFeeApplied>&#xa;                &lt;xsl:value-of select=&quot;min(($feeApplied, $lateFee))&quot;/>&#xa;            &lt;/tns:lateFeeApplied>&#xa;            &lt;tns:interestApplied>&#xa;                &lt;xsl:value-of select=&quot;$interestApplied&quot;/>&#xa;            &lt;/tns:interestApplied>&#xa;            &lt;tns:principalApplied>&#xa;                &lt;xsl:value-of select=&quot;$principalApplied&quot;/>&#xa;            &lt;/tns:principalApplied>&#xa;            &lt;tns:newFeesDue>&#xa;                &lt;xsl:value-of select=&quot;$fees - $feeApplied&quot;/>&#xa;            &lt;/tns:newFeesDue>&#xa;            &lt;tns:newAccruedInterest>&#xa;                &lt;xsl:value-of select=&quot;$interest - $interestApplied&quot;/>&#xa;            &lt;/tns:newAccruedInterest>&#xa;            &lt;tns:newPrincipalBalance>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($LoadAccount/Record[1]/principal_balance) - $principalApplied&quot;/>&#xa;            &lt;/tns:newPrincipalBalance>&#xa;        &lt;/tns:PaymentAllocation>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:ns3="http://xmlns.gmfin.example/loan/servicing/payment"
                                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                        <properties name="config"
                                            xsi:type="activityconfig:EMFProperty">
                                            <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                            <value inputQName="ns3:PaymentAllocation"
                                                xsi:type="generalactivities:Mapper"/>
                                        </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension inputVariable="InsertPayment-input"
                            name="InsertPayment" outputVariable="InsertPayment"
                            tibex:xpdlId="9fc69bae-c4c7-542f-a4a1-1bf9d0e8160a"
                            xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="AllocatePaymentToInsertPayment"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="InsertPaymentToUpdateLoanAccount"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/loan/servicing/payment&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9fc69bae-c4c7-542f-a4a1-1bf9d0e8160a+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceivePayment&quot;/>&#xa;    &lt;xsl:param name=&quot;AllocatePayment&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertPayment-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;paymentId>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:paymentId&quot;/>&#xa;            &lt;/paymentId>&#xa;            &lt;accountNumber>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:accountNumber&quot;/>&#xa;            &lt;/accountNumber>&#xa;            &lt;amount>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:amount&quot;/>&#xa;            &lt;/amount>&#xa;            &lt;channel>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:channel&quot;/>&#xa;            &lt;/channel>&#xa;            &lt;receivedDate>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:receivedDate&quot;/>&#xa;            &lt;/receivedDate>&#xa;            &lt;feeApplied>&#xa;                &lt;xsl:value-of select=&quot;$AllocatePayment/tns:feeApplied&quot;/>&#xa;            &lt;/feeApplied>&#xa;            &lt;lateFeeApplied>&#xa;                &lt;xsl:value-of select=&quot;$AllocatePayment/tns:lateFeeApplied&quot;/>&#xa;            &lt;/lateFeeApplied>&#xa;            &lt;interestApplied>&#xa;                &lt;xsl:value-of select=&quot;$AllocatePayment/tns:interestApplied&quot;/>&#xa;            &lt;/interestApplied>&#xa;            &lt;principalApplied>&#xa;                &lt;xsl:value-of select=&quot;$AllocatePayment/tns:principalApplied&quot;/>&#xa;            &lt;/principalApplied>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                        <properties name="config"
                                            xsi:type="activityconfig:EMFProperty">
                                            <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                            <value sharedResourceProperty="jdbcProperty"
                                                sqlStatement="insert into gmf.payment&#xa;  (payment_id, account_number, amount, channel, received_date, fee_applied, late_fee_applied, interest_applied, principal_applied, posted_at)&#xa;values (?, ?, ?, ?, ?, ?, ?, ?, ?, current_timestamp)"
                                                timeout="10"
                                                xsi:type="jdbcPalette:JDBCUpdateActivity">
                                                <PreparedParameters DataType="12"
                                                    DataTypeDisplayValue="VARCHAR"
                                                    ParameterName="paymentId"/>
                                                <PreparedParameters DataType="12"
                                                    DataTypeDisplayValue="VARCHAR"
                                                    ParameterName="accountNumber"/>
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="amount"/>
                                                <PreparedParameters DataType="12"
                                                    DataTypeDisplayValue="VARCHAR"
                                                    ParameterName="channel"/>
                                                <PreparedParameters DataType="91"
                                                    DataTypeDisplayValue="DATE"
                                                    ParameterName="receivedDate"/>
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="feeApplied"/>
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="lateFeeApplied"/>
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="interestApplied"/>
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="principalApplied"/>
                                            </value>
                                        </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension inputVariable="UpdateLoanAccount-input"
                            name="UpdateLoanAccount"
                            outputVariable="UpdateLoanAccount"
                            tibex:xpdlId="b3ad2157-625b-5490-a3d9-6112ddf80748"
                            xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="InsertPaymentToUpdateLoanAccount"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="UpdateLoanAccountToGroupEnd"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/loan/servicing/payment&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b3ad2157-625b-5490-a3d9-6112ddf80748+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceivePayment&quot;/>&#xa;    &lt;xsl:param name=&quot;AllocatePayment&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateLoanAccount-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;feesDue>&#xa;                &lt;xsl:value-of select=&quot;$AllocatePayment/tns:newFeesDue&quot;/>&#xa;            &lt;/feesDue>&#xa;            &lt;accruedInterest>&#xa;                &lt;xsl:value-of select=&quot;$AllocatePayment/tns:newAccruedInterest&quot;/>&#xa;            &lt;/accruedInterest>&#xa;            &lt;principalBalance>&#xa;                &lt;xsl:value-of select=&quot;$AllocatePayment/tns:newPrincipalBalance&quot;/>&#xa;            &lt;/principalBalance>&#xa;            &lt;lastPaymentDate>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:receivedDate&quot;/>&#xa;            &lt;/lastPaymentDate>&#xa;            &lt;accountNumber>&#xa;                &lt;xsl:value-of select=&quot;$ReceivePayment/Body/tns:Payment/tns:accountNumber&quot;/>&#xa;            &lt;/accountNumber>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                        <properties name="config"
                                            xsi:type="activityconfig:EMFProperty">
                                            <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                            <value sharedResourceProperty="jdbcProperty"
                                                sqlStatement="update gmf.loan_account&#xa;   set fees_due = ?, accrued_interest = ?, principal_balance = ?, last_payment_date = ?&#xa; where account_number = ?"
                                                timeout="10"
                                                xsi:type="jdbcPalette:JDBCUpdateActivity">
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="feesDue"/>
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="accruedInterest"/>
                                                <PreparedParameters DataType="2"
                                                    DataTypeDisplayValue="NUMERIC"
                                                    ParameterName="principalBalance"/>
                                                <PreparedParameters DataType="91"
                                                    DataTypeDisplayValue="DATE"
                                                    ParameterName="lastPaymentDate"/>
                                                <PreparedParameters DataType="12"
                                                    DataTypeDisplayValue="VARCHAR"
                                                    ParameterName="accountNumber"/>
                                            </value>
                                        </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:empty name="GroupEnd" tibex:group="groupEnd"
                        tibex:xpdlId="ba2cae5a-6ddb-51c9-9e08-68d8dbe283e6">
                        <bpws:targets>
                            <bpws:target linkName="UpdateLoanAccountToGroupEnd"/>
                        </bpws:targets>
                    </bpws:empty>
                </bpws:flow>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogPaymentPosted-input"
                    name="LogPaymentPosted"
                    tibex:xpdlId="c902d7b7-d3f3-5002-a1ad-db103873e3e5"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PostPaymentTransactionToLogPaymentPosted"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/loan/servicing/payment&quot; xmlns:tns4=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceivePayment&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPaymentPosted-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LS-200&amp;quot;&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Payment ', $ReceivePayment/Body/tns:Payment/tns:paymentId, ' posted')&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns4:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value controlBy="Application" role="Info"
                                        suppressJobInfo="true"
                                        xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
