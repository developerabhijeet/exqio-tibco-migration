            <complexType name="RecordType">
                <sequence>
                    <element minOccurs="0" name="application_id" type="string"/>
                    <element minOccurs="0" name="status" type="string"/>
                    <element minOccurs="0" name="submitted_at" type="dateTime"/>
                </sequence>
            </complexType>
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record" type="tns:RecordType"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
