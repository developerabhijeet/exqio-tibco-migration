                                            variable="ReplyServerError-input">
                                            <tibex:inputBindings>
                                                <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyServerError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:server5XXError>&#xa;            &lt;statusCode>&#xa;                &lt;xsl:value-of select=&quot;503&quot;/>&#xa;            &lt;/statusCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:server5XXError>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                            </tibex:inputBindings>
                                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://tns.tibco.com/bw/REST" xmlns:tns8="http://xmlns.example.com/20190314093512PLT" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="ReplyServerError-input" match="/"&gt;&lt;tns8:post5XXFaultMessage&gt;&lt;serverError&gt;&lt;tns6:server5XXError&gt;&lt;statusCode&gt;&lt;xsl:value-of select="503"/&gt;&lt;/statusCode&gt;&lt;message&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/message&gt;&lt;/tns6:server5XXError&gt;&lt;/serverError&gt;&lt;/tns8:post5XXFaultMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                        </bpws:reply>
                                    </bpws:flow>
                                </bpws:scope>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="NormalizeApplicantToCallAuditLog"
                                    tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallAuditLogToCallValidateVIN"
                                    tibex:label="SSN format valid"
                                    tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallAuditLogToReplyInvalidSSN"
                                    tibex:label=""
                                    tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="CallValidateVINToCheckDuplicateApplication"
                                    tibex:label="VIN valid"
                                    tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallValidateVINToReplyInvalidVIN"
                                    tibex:label=""
                                    tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="CheckDuplicateApplicationToThrowDuplicateApplication"
                                    tibex:label="Duplicate within 30 days"
                                    tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CheckDuplicateApplicationToCallBureauOrchestrator"
                                    tibex:label=""
                                    tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="CallBureauOrchestratorToCallDecisionEngine"
                                    tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallDecisionEngineTopostOut"
                                    tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart"
                                tibex:constructor="onMessageStart"
                                tibex:xpdlId="3493c97a-aa16-5e26-bb95-91fba7dee072"/>
                            <bpws:empty name="OnMessageEnd"
                                tibex:constructor="onMessageEnd"
                                tibex:xpdlId="d88b5463-3492-537e-8310-2e093499c337"/>
                            <bpws:extensionActivity>
                                <tibex:activityExtension inputVariable="NormalizeApplicant-input"
                                    name="NormalizeApplicant"
                                    outputVariable="NormalizeApplicant"
                                    tibex:xpdlId="9ee66ed5-9e66-5441-9c2d-27d22f5325fe"
                                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                        <bpws:source linkName="NormalizeApplicantToCallAuditLog"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;NormalizeApplicant-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ApplicantSnapshot>&#xa;            &lt;tns:applicationId>&#xa;                &lt;xsl:value-of select=&quot;normalize-space($post.item/tns:applicationId)&quot;/>&#xa;            &lt;/tns:applicationId>&#xa;            &lt;tns:dealerId>&#xa;                &lt;xsl:value-of select=&quot;upper-case(normalize-space($post.item/tns:dealerId))&quot;/>&#xa;            &lt;/tns:dealerId>&#xa;            &lt;tns:ssn>&#xa;                &lt;xsl:value-of select=&quot;normalize-space($post.item/tns:applicant/tns:ssn)&quot;/>&#xa;            &lt;/tns:ssn>&#xa;            &lt;tns:firstName>&#xa;                &lt;xsl:value-of select=&quot;upper-case(normalize-space($post.item/tns:applicant/tns:firstName))&quot;/>&#xa;            &lt;/tns:firstName>&#xa;            &lt;tns:lastName>&#xa;                &lt;xsl:value-of select=&quot;upper-case(normalize-space($post.item/tns:applicant/tns:lastName))&quot;/>&#xa;            &lt;/tns:lastName>&#xa;            &lt;tns:dateOfBirth>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns:applicant/tns:dateOfBirth&quot;/>&#xa;            &lt;/tns:dateOfBirth>&#xa;            &lt;tns:vin>&#xa;                &lt;xsl:value-of select=&quot;upper-case(normalize-space($post.item/tns:vehicle/tns:vin))&quot;/>&#xa;            &lt;/tns:vin>&#xa;        &lt;/tns:ApplicantSnapshot>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                        <bwext:BWActivity activityTypeID="bw.generalactivities.mapper"
                                            version="6.0.0.001"
                                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                            xmlns:ns1="http://xmlns.gmfin.example/credit/origination/application"
                                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                            <activityConfig>
                                                <properties name="config"
                                                    xsi:type="activityconfig:EMFProperty">
                                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                                    <value inputQName="ns1:ApplicantSnapshot"
                                                        xsi:type="generalactivities:Mapper"/>
                                                </properties>
                                            </activityConfig>
                                        </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallAuditLog-input"
                                    name="CallAuditLog"
                                    tibex:xpdlId="e78a4f42-8a05-58e0-af08-c4027cc8e134"
                                    type="bw.generalactivities.callprocess"
                                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                        <bpws:target linkName="NormalizeApplicantToCallAuditLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                        <bpws:source linkName="CallAuditLogToCallValidateVIN">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="matches($NormalizeApplicant/tns:ssn, '^[0-9]{3}-[0-9]{2}-[0-9]{4}$') and not(substring($NormalizeApplicant/tns:ssn, 1, 3) = ('000', '666'))"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[matches($NormalizeApplicant/tns:ssn, '^[0-9]{3}-[0-9]{2}-[0-9]{4}$') and not(substring($NormalizeApplicant/tns:ssn, 1, 3) = ('000', '666'))]]></bpws:transitionCondition>
                                        </bpws:source>
                                        <bpws:source linkName="CallAuditLogToReplyInvalidSSN">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="##otherwise##"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                        </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; xmlns:tns1=&quot;http://xmlns.gmfin.example/credit/origination/audit&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NormalizeApplicant&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CallAuditLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:AuditEvent>&#xa;            &lt;tns1:eventType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;APPLICATION_RECEIVED&amp;quot;&quot;/>&#xa;            &lt;/tns1:eventType>&#xa;            &lt;tns1:applicationId>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:applicationId&quot;/>&#xa;            &lt;/tns1:applicationId>&#xa;            &lt;tns1:ssn>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:ssn&quot;/>&#xa;            &lt;/tns1:ssn>&#xa;            &lt;tns1:payload>&#xa;                &lt;xsl:value-of select=&quot;concat('dealer=', $NormalizeApplicant/tns:dealerId, ';vin=', $NormalizeApplicant/tns:vin, ';amount=', $post.item/tns:requestedAmount, ';term=', $post.item/tns:requestedTermMonths)&quot;/>&#xa;            &lt;/tns1:payload>&#xa;        &lt;/tns1:AuditEvent>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess subProcessName="creditorigination.AuditLog"
                                        xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:reply faultName="clientFault"
                                name="ReplyInvalidSSN" operation="post"
                                partnerLink="applications"
                                portType="ns0:applications"
                                tibex:xpdlId="46c6a1fd-7b26-5db8-a6af-ad36d0464f3c"
                                variable="ReplyInvalidSSN-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ReplyInvalidSSN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:client4XXError>&#xa;            &lt;statusCode>&#xa;                &lt;xsl:value-of select=&quot;400&quot;/>&#xa;            &lt;/statusCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;SSN must be formatted NNN-NN-NNNN&amp;quot;&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:client4XXError>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://tns.tibco.com/bw/REST" xmlns:tns8="http://xmlns.example.com/20190314093512PLT" version="2.0"&gt;&lt;xsl:template name="ReplyInvalidSSN-input" match="/"&gt;&lt;tns8:post4XXFaultMessage&gt;&lt;clientError&gt;&lt;tns6:client4XXError&gt;&lt;statusCode&gt;&lt;xsl:value-of select="400"/&gt;&lt;/statusCode&gt;&lt;message&gt;&lt;xsl:value-of select="&amp;quot;SSN must be formatted NNN-NN-NNNN&amp;quot;"/&gt;&lt;/message&gt;&lt;/tns6:client4XXError&gt;&lt;/clientError&gt;&lt;/tns8:post4XXFaultMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="CallAuditLogToReplyInvalidSSN"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:extActivity expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallValidateVIN-input"
                                    name="CallValidateVIN"
                                    outputVariable="CallValidateVIN"
                                    tibex:xpdlId="e5ccafa3-0c5a-59b2-9ead-f6180a818321"
                                    type="bw.generalactivities.callprocess"
                                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                        <bpws:target linkName="CallAuditLogToCallValidateVIN"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                        <bpws:source linkName="CallValidateVINToCheckDuplicateApplication">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="$CallValidateVIN/tns2:valid = 'true'"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$CallValidateVIN/tns2:valid = 'true']]></bpws:transitionCondition>
                                        </bpws:source>
                                        <bpws:source linkName="CallValidateVINToReplyInvalidVIN">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="##otherwise##"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                        </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; xmlns:tns2=&quot;http://xmlns.gmfin.example/credit/origination/vehicle&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NormalizeApplicant&quot;/>&#xa;    &lt;xsl:template name=&quot;CallValidateVIN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:VinValidationRequest>&#xa;            &lt;tns2:vin>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:vin&quot;/>&#xa;            &lt;/tns2:vin>&#xa;        &lt;/tns2:VinValidationRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess subProcessName="creditorigination.ValidateVIN"
                                        xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:reply faultName="clientFault"
                                name="ReplyInvalidVIN" operation="post"
                                partnerLink="applications"
                                portType="ns0:applications"
                                tibex:xpdlId="a1724c54-bc36-58ad-97e3-0521583da837"
                                variable="ReplyInvalidVIN-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.gmfin.example/credit/origination/vehicle&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallValidateVIN&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyInvalidVIN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:client4XXError>&#xa;            &lt;statusCode>&#xa;                &lt;xsl:value-of select=&quot;400&quot;/>&#xa;            &lt;/statusCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;VIN rejected: &amp;quot;, $CallValidateVIN/tns2:reason)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:client4XXError>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.gmfin.example/credit/origination/vehicle" xmlns:tns6="http://tns.tibco.com/bw/REST" xmlns:tns8="http://xmlns.example.com/20190314093512PLT" version="2.0"&gt;&lt;xsl:param name="CallValidateVIN"/&gt;&lt;xsl:template name="ReplyInvalidVIN-input" match="/"&gt;&lt;tns8:post4XXFaultMessage&gt;&lt;clientError&gt;&lt;tns6:client4XXError&gt;&lt;statusCode&gt;&lt;xsl:value-of select="400"/&gt;&lt;/statusCode&gt;&lt;message&gt;&lt;xsl:value-of select="concat(&amp;quot;VIN rejected: &amp;quot;, $CallValidateVIN/tns2:reason)"/&gt;&lt;/message&gt;&lt;/tns6:client4XXError&gt;&lt;/clientError&gt;&lt;/tns8:post4XXFaultMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="CallValidateVINToReplyInvalidVIN"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension inputVariable="CheckDuplicateApplication-input"
                                    name="CheckDuplicateApplication"
                                    outputVariable="CheckDuplicateApplication"
                                    tibex:xpdlId="e938235c-8a55-5e6f-b182-62f9ebc65c69"
                                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                        <bpws:target linkName="CallValidateVINToCheckDuplicateApplication"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                        <bpws:source linkName="CheckDuplicateApplicationToThrowDuplicateApplication">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="count($CheckDuplicateApplication/Record) > 0"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CheckDuplicateApplication/Record) > 0]]></bpws:transitionCondition>
                                        </bpws:source>
                                        <bpws:source linkName="CheckDuplicateApplicationToCallBureauOrchestrator">
                                            <tibex:DesignExpression>
                                                <tibex:expression expression="##otherwise##"
                                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                            </tibex:DesignExpression>
                                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                        </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e938235c-8a55-5e6f-b182-62f9ebc65c69+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NormalizeApplicant&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckDuplicateApplication-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;ssn>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:ssn&quot;/>&#xa;            &lt;/ssn>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                        <bwext:BWActivity activityTypeID="bw.jdbc.JDBCQuery"
                                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                            <activityConfig>
                                                <properties name="config"
                                                    xsi:type="activityconfig:EMFProperty">
                                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                                    <value maxRows="100"
                                                        sharedResourceProperty="jdbcProperty"
                                                        sqlStatement="select application_id, status, submitted_at&#xa;  from gmf.credit_application&#xa; where ssn = ?&#xa;   and submitted_at >= current_timestamp - interval '30 days'"
                                                        timeout="10"
                                                        xsi:type="jdbcPalette:JDBCQueryActivity">
                                                        <PreparedParameters DataType="12"
                                                            DataTypeDisplayValue="VARCHAR"
                                                            ParameterName="ssn"/>
                                                        <columnMetadata columnName="application_id"
                                                            dataType="12"
                                                            status="OptionalElement"
                                                            typeName="varchar"/>
                                                        <columnMetadata columnName="status"
                                                            dataType="12"
                                                            status="OptionalElement"
                                                            typeName="varchar"/>
                                                        <columnMetadata columnName="submitted_at"
                                                            dataType="93"
                                                            status="OptionalElement"
                                                            typeName="timestamp"/>
                                                    </value>
                                                </properties>
                                            </activityConfig>
                                        </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:throw faultName="ns6:DuplicateApplicationFault"
                                faultVariable="ThrowDuplicateApplication-input"
                                name="ThrowDuplicateApplication"
                                tibex:xpdlId="0260a13a-dc5f-568e-8815-8c3ced6f887f">
                                <tibex:inputBindings>
                                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; xmlns:tns5=&quot;http://xmlns.gmfin.example/credit/origination/faults&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NormalizeApplicant&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDuplicateApplication&quot;/>&#xa;    &lt;xsl:template name=&quot;ThrowDuplicateApplication-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:DuplicateApplicationFault>&#xa;            &lt;tns5:applicationId>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:applicationId&quot;/>&#xa;            &lt;/tns5:applicationId>&#xa;            &lt;tns5:existingApplicationId>&#xa;                &lt;xsl:value-of select=&quot;$CheckDuplicateApplication/Record[1]/application_id&quot;/>&#xa;            &lt;/tns5:existingApplicationId>&#xa;            &lt;tns5:message>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Application already submitted for this SSN within 30 days&amp;quot;&quot;/>&#xa;            &lt;/tns5:message>&#xa;        &lt;/tns5:DuplicateApplicationFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CheckDuplicateApplicationToThrowDuplicateApplication"/>
                                </bpws:targets>
                            </bpws:throw>
                            <bpws:extensionActivity>
                                <tibex:extActivity expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallBureauOrchestrator-input"
                                    name="CallBureauOrchestrator"
                                    outputVariable="CallBureauOrchestrator"
                                    tibex:xpdlId="2b852bbd-8410-54a4-a6b4-c541d2f3f8e6"
                                    type="bw.generalactivities.callprocess"
                                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                        <bpws:target linkName="CheckDuplicateApplicationToCallBureauOrchestrator"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                        <bpws:source linkName="CallBureauOrchestratorToCallDecisionEngine"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; xmlns:tns3=&quot;http://xmlns.gmfin.example/credit/origination/bureau&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NormalizeApplicant&quot;/>&#xa;    &lt;xsl:template name=&quot;CallBureauOrchestrator-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:BureauRequest>&#xa;            &lt;tns3:applicationId>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:applicationId&quot;/>&#xa;            &lt;/tns3:applicationId>&#xa;            &lt;tns3:ssn>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:ssn&quot;/>&#xa;            &lt;/tns3:ssn>&#xa;            &lt;tns3:firstName>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:firstName&quot;/>&#xa;            &lt;/tns3:firstName>&#xa;            &lt;tns3:lastName>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:lastName&quot;/>&#xa;            &lt;/tns3:lastName>&#xa;            &lt;tns3:dateOfBirth>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:dateOfBirth&quot;/>&#xa;            &lt;/tns3:dateOfBirth>&#xa;        &lt;/tns3:BureauRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess subProcessName="creditorigination.BureauOrchestrator"
                                        xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallDecisionEngine-input"
                                    name="CallDecisionEngine"
                                    outputVariable="CallDecisionEngine"
                                    tibex:xpdlId="be48188f-da4d-59ea-b30c-942d50a25627"
                                    type="bw.generalactivities.callprocess"
                                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                        <bpws:target linkName="CallBureauOrchestratorToCallDecisionEngine"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                        <bpws:source linkName="CallDecisionEngineTopostOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; xmlns:tns3=&quot;http://xmlns.gmfin.example/credit/origination/bureau&quot; xmlns:tns4=&quot;http://xmlns.gmfin.example/credit/origination/decision&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NormalizeApplicant&quot;/>&#xa;    &lt;xsl:param name=&quot;CallBureauOrchestrator&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CallDecisionEngine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:DecisionRequest>&#xa;            &lt;parameters>&#xa;                &lt;applicationId>&#xa;                    &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:applicationId&quot;/>&#xa;                &lt;/applicationId>&#xa;                &lt;ssn>&#xa;                    &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:ssn&quot;/>&#xa;                &lt;/ssn>&#xa;                &lt;dealerId>&#xa;                    &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:dealerId&quot;/>&#xa;                &lt;/dealerId>&#xa;                &lt;vin>&#xa;                    &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:vin&quot;/>&#xa;                &lt;/vin>&#xa;                &lt;creditScore>&#xa;                    &lt;xsl:value-of select=&quot;$CallBureauOrchestrator/tns3:selectedScore&quot;/>&#xa;                &lt;/creditScore>&#xa;                &lt;singleBureau>&#xa;                    &lt;xsl:value-of select=&quot;$CallBureauOrchestrator/tns3:singleBureau&quot;/>&#xa;                &lt;/singleBureau>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:applicant/tns:monthlyIncome&quot;>&#xa;                    &lt;monthlyIncome>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:applicant/tns:monthlyIncome&quot;/>&#xa;                    &lt;/monthlyIncome>&#xa;                &lt;/xsl:if>&#xa;                &lt;monthlyDebt>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:applicant/tns:monthlyDebt&quot;/>&#xa;                &lt;/monthlyDebt>&#xa;                &lt;requestedAmount>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:requestedAmount&quot;/>&#xa;                &lt;/requestedAmount>&#xa;                &lt;requestedTermMonths>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:requestedTermMonths&quot;/>&#xa;                &lt;/requestedTermMonths>&#xa;            &lt;/parameters>&#xa;        &lt;/tns4:DecisionRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess subProcessName="creditorigination.DecisionEngine"
                                        xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:reply name="postOut" operation="post"
                                partnerLink="applications"
                                portType="ns0:applications"
                                tibex:xpdlId="bc88bfc3-ab9f-56de-ba3d-9c91a385c224"
                                variable="postOut-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/application&quot; xmlns:tns3=&quot;http://xmlns.gmfin.example/credit/origination/bureau&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NormalizeApplicant&quot;/>&#xa;    &lt;xsl:param name=&quot;CallBureauOrchestrator&quot;/>&#xa;    &lt;xsl:param name=&quot;CallDecisionEngine&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CreditApplicationResponse>&#xa;            &lt;tns:applicationId>&#xa;                &lt;xsl:value-of select=&quot;$NormalizeApplicant/tns:applicationId&quot;/>&#xa;            &lt;/tns:applicationId>&#xa;            &lt;tns:decision>&#xa;                &lt;xsl:value-of select=&quot;$CallDecisionEngine/decision&quot;/>&#xa;            &lt;/tns:decision>&#xa;            &lt;xsl:if test=&quot;$CallDecisionEngine/tier&quot;>&#xa;                &lt;tns:tier>&#xa;                    &lt;xsl:value-of select=&quot;$CallDecisionEngine/tier&quot;/>&#xa;                &lt;/tns:tier>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:apr>&#xa;                &lt;xsl:value-of select=&quot;$CallDecisionEngine/apr&quot;/>&#xa;            &lt;/tns:apr>&#xa;            &lt;tns:approvedAmount>&#xa;                &lt;xsl:value-of select=&quot;$CallDecisionEngine/approvedAmount&quot;/>&#xa;            &lt;/tns:approvedAmount>&#xa;            &lt;tns:approvedTermMonths>&#xa;                &lt;xsl:value-of select=&quot;$CallDecisionEngine/approvedTermMonths&quot;/>&#xa;            &lt;/tns:approvedTermMonths>&#xa;            &lt;tns:creditScore>&#xa;                &lt;xsl:value-of select=&quot;$CallBureauOrchestrator/tns3:selectedScore&quot;/>&#xa;            &lt;/tns:creditScore>&#xa;            &lt;xsl:if test=&quot;$CallBureauOrchestrator/tns3:equifaxScore&quot;>&#xa;                &lt;tns:equifaxScore>&#xa;                    &lt;xsl:value-of select=&quot;$CallBureauOrchestrator/tns3:equifaxScore&quot;/>&#xa;                &lt;/tns:equifaxScore>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:singleBureau>&#xa;                &lt;xsl:value-of select=&quot;$CallBureauOrchestrator/tns3:singleBureau&quot;/>&#xa;            &lt;/tns:singleBureau>&#xa;            &lt;tns:decidedAt>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns:decidedAt>&#xa;        &lt;/tns:CreditApplicationResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.gmfin.example/credit/origination/application" xmlns:tns3="http://xmlns.gmfin.example/credit/origination/bureau" xmlns:tns8="http://xmlns.example.com/20190314093512PLT" version="2.0"&gt;&lt;xsl:param name="NormalizeApplicant"/&gt;&lt;xsl:param name="CallBureauOrchestrator"/&gt;&lt;xsl:param name="CallDecisionEngine"/&gt;&lt;xsl:template name="postOut-input" match="/"&gt;&lt;tns8:postResponse&gt;&lt;item&gt;&lt;tns:CreditApplicationResponse&gt;&lt;tns:applicationId&gt;&lt;xsl:value-of select="$NormalizeApplicant/tns:applicationId"/&gt;&lt;/tns:applicationId&gt;&lt;tns:decision&gt;&lt;xsl:value-of select="$CallDecisionEngine/decision"/&gt;&lt;/tns:decision&gt;&lt;xsl:if test="$CallDecisionEngine/tier"&gt;&lt;tns:tier&gt;&lt;xsl:value-of select="$CallDecisionEngine/tier"/&gt;&lt;/tns:tier&gt;&lt;/xsl:if&gt;&lt;tns:apr&gt;&lt;xsl:value-of select="$CallDecisionEngine/apr"/&gt;&lt;/tns:apr&gt;&lt;tns:approvedAmount&gt;&lt;xsl:value-of select="$CallDecisionEngine/approvedAmount"/&gt;&lt;/tns:approvedAmount&gt;&lt;tns:approvedTermMonths&gt;&lt;xsl:value-of select="$CallDecisionEngine/approvedTermMonths"/&gt;&lt;/tns:approvedTermMonths&gt;&lt;tns:creditScore&gt;&lt;xsl:value-of select="$CallBureauOrchestrator/tns3:selectedScore"/&gt;&lt;/tns:creditScore&gt;&lt;xsl:if test="$CallBureauOrchestrator/tns3:equifaxScore"&gt;&lt;tns:equifaxScore&gt;&lt;xsl:value-of select="$CallBureauOrchestrator/tns3:equifaxScore"/&gt;&lt;/tns:equifaxScore&gt;&lt;/xsl:if&gt;&lt;tns:singleBureau&gt;&lt;xsl:value-of select="$CallBureauOrchestrator/tns3:singleBureau"/&gt;&lt;/tns:singleBureau&gt;&lt;tns:decidedAt&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:decidedAt&gt;&lt;/tns:CreditApplicationResponse&gt;&lt;/item&gt;&lt;/tns8:postResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="CallDecisionEngineTopostOut"/>
                                </bpws:targets>
                            </bpws:reply>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
