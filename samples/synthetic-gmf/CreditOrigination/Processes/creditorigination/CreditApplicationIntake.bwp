            </plnk:partnerLinkType>
            <wsdl:import namespace="http://tns.tibco.com/bw/REST"/>
            <wsdl:import namespace="http://xmlns.gmfin.example/credit/origination/application"/>
            <wsdl:message name="postRequest">
                <wsdl:part element="extns1:CreditApplicationRequest"
