            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="RecordDecision-input"
                    name="RecordDecision" outputVariable="RecordDecision"
                    tibex:xpdlId="b330a219-6c99-5d32-8815-c1ec8044f3a6"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignTierAToRecordDecision"/>
                        <bpws:target linkName="AssignTierBToRecordDecision"/>
                        <bpws:target linkName="AssignTierCToRecordDecision"/>
                        <bpws:target linkName="AssignDeclineToRecordDecision"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecordDecisionToRecordApplication"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b330a219-6c99-5d32-8815-c1ec8044f3a6+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ComputeDTI&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierA&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierB&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierC&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignDecline&quot;/>&#xa;    &lt;xsl:template name=&quot;RecordDecision-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:variable name=&quot;assigned&quot; select=&quot;($AssignTierA, $AssignTierB, $AssignTierC, $AssignDecline)[1]&quot;/>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;applicationId>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/applicationId&quot;/>&#xa;            &lt;/applicationId>&#xa;            &lt;xsl:if test=&quot;$assigned/tier&quot;>&#xa;                &lt;tier>&#xa;                    &lt;xsl:value-of select=&quot;$assigned/tier&quot;/>&#xa;                &lt;/tier>&#xa;            &lt;/xsl:if>&#xa;            &lt;decision>&#xa;                &lt;xsl:value-of select=&quot;$assigned/decision&quot;/>&#xa;            &lt;/decision>&#xa;            &lt;apr>&#xa;                &lt;xsl:value-of select=&quot;$assigned/apr&quot;/>&#xa;            &lt;/apr>&#xa;            &lt;approvedAmount>&#xa;                &lt;xsl:value-of select=&quot;$assigned/approvedAmount&quot;/>&#xa;            &lt;/approvedAmount>&#xa;            &lt;approvedTermMonths>&#xa;                &lt;xsl:value-of select=&quot;$assigned/approvedTermMonths&quot;/>&#xa;            &lt;/approvedTermMonths>&#xa;            &lt;dti>&#xa;                &lt;xsl:value-of select=&quot;$ComputeDTI/dti&quot;/>&#xa;            &lt;/dti>&#xa;            &lt;creditScore>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/creditScore&quot;/>&#xa;            &lt;/creditScore>&#xa;            &lt;singleBureau>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/singleBureau&quot;/>&#xa;            &lt;/singleBureau>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value sharedResourceProperty="jdbcProperty"
                                        sqlStatement="insert into gmf.decision&#xa;  (application_id, tier, decision, apr, approved_amount, approved_term_months, dti, credit_score, single_bureau, decided_at)&#xa;values (?, ?, ?, ?, ?, ?, ?, ?, ?, current_timestamp)"
                                        timeout="10"
                                        xsi:type="jdbcPalette:JDBCUpdateActivity">
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="applicationId"/>
                                        <PreparedParameters DataType="1"
                                            DataTypeDisplayValue="CHAR"
                                            ParameterName="tier"/>
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="decision"/>
                                        <PreparedParameters DataType="2"
                                            DataTypeDisplayValue="NUMERIC"
                                            ParameterName="apr"/>
                                        <PreparedParameters DataType="2"
                                            DataTypeDisplayValue="NUMERIC"
                                            ParameterName="approvedAmount"/>
                                        <PreparedParameters DataType="4"
                                            DataTypeDisplayValue="INTEGER"
                                            ParameterName="approvedTermMonths"/>
                                        <PreparedParameters DataType="2"
                                            DataTypeDisplayValue="NUMERIC"
                                            ParameterName="dti"/>
                                        <PreparedParameters DataType="4"
                                            DataTypeDisplayValue="INTEGER"
                                            ParameterName="creditScore"/>
                                        <PreparedParameters DataType="16"
                                            DataTypeDisplayValue="BOOLEAN"
                                            ParameterName="singleBureau"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="RecordApplication-input"
                    name="RecordApplication" outputVariable="RecordApplication"
                    tibex:xpdlId="6530d112-c9cc-5c6f-af66-6ca434b6a871"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecordDecisionToRecordApplication"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecordApplicationToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6530d112-c9cc-5c6f-af66-6ca434b6a871+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierA&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierB&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierC&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignDecline&quot;/>&#xa;    &lt;xsl:template name=&quot;RecordApplication-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;applicationId>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/applicationId&quot;/>&#xa;            &lt;/applicationId>&#xa;            &lt;ssn>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/ssn&quot;/>&#xa;            &lt;/ssn>&#xa;            &lt;vin>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/vin&quot;/>&#xa;            &lt;/vin>&#xa;            &lt;dealerId>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/dealerId&quot;/>&#xa;            &lt;/dealerId>&#xa;            &lt;requestedAmount>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/requestedAmount&quot;/>&#xa;            &lt;/requestedAmount>&#xa;            &lt;requestedTermMonths>&#xa;                &lt;xsl:value-of select=&quot;$Start/parameters/requestedTermMonths&quot;/>&#xa;            &lt;/requestedTermMonths>&#xa;            &lt;status>&#xa;                &lt;xsl:value-of select=&quot;($AssignTierA, $AssignTierB, $AssignTierC, $AssignDecline)[1]/decision&quot;/>&#xa;            &lt;/status>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value sharedResourceProperty="jdbcProperty"
                                        sqlStatement="insert into gmf.credit_application&#xa;  (application_id, ssn, vin, dealer_id, requested_amount, requested_term_months, status, submitted_at)&#xa;values (?, ?, ?, ?, ?, ?, ?, current_timestamp)"
                                        timeout="10"
                                        xsi:type="jdbcPalette:JDBCUpdateActivity">
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="applicationId"/>
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="ssn"/>
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="vin"/>
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="dealerId"/>
                                        <PreparedParameters DataType="2"
                                            DataTypeDisplayValue="NUMERIC"
                                            ParameterName="requestedAmount"/>
                                        <PreparedParameters DataType="4"
                                            DataTypeDisplayValue="INTEGER"
                                            ParameterName="requestedTermMonths"/>
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="status"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input" name="End"
                    tibex:xpdlId="4df5a564-4c9a-587e-b3fe-393e13e84691"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecordApplicationToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/decision&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ComputeDTI&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierA&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierB&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignTierC&quot;/>&#xa;    &lt;xsl:param name=&quot;AssignDecline&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:variable name=&quot;assigned&quot; select=&quot;($AssignTierA, $AssignTierB, $AssignTierC, $AssignDecline)[1]&quot;/>&#xa;        &lt;tns:DecisionResult>&#xa;            &lt;decision>&#xa;                &lt;xsl:value-of select=&quot;$assigned/decision&quot;/>&#xa;            &lt;/decision>&#xa;            &lt;xsl:if test=&quot;$assigned/tier&quot;>&#xa;                &lt;tier>&#xa;                    &lt;xsl:value-of select=&quot;$assigned/tier&quot;/>&#xa;                &lt;/tier>&#xa;            &lt;/xsl:if>&#xa;            &lt;apr>&#xa;                &lt;xsl:value-of select=&quot;$assigned/apr&quot;/>&#xa;            &lt;/apr>&#xa;            &lt;approvedAmount>&#xa;                &lt;xsl:value-of select=&quot;$assigned/approvedAmount&quot;/>&#xa;            &lt;/approvedAmount>&#xa;            &lt;approvedTermMonths>&#xa;                &lt;xsl:value-of select=&quot;$assigned/approvedTermMonths&quot;/>&#xa;            &lt;/approvedTermMonths>&#xa;            &lt;dti>&#xa;                &lt;xsl:value-of select=&quot;$ComputeDTI/dti&quot;/>&#xa;            &lt;/dti>&#xa;        &lt;/tns:DecisionResult>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
