            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="MergeScores-input"
                    name="MergeScores" outputVariable="MergeScores"
                    tibex:xpdlId="f6b3972e-662d-5bf7-b805-d60b511fcf39"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParallelBureauPullsToMergeScores"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MergeScoresToThrowBureauUnavailable">
                            <tibex:DesignExpression>
                                <tibex:expression expression="xsd:integer($MergeScores/tns:bureauCount) = 0"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[xsd:integer($MergeScores/tns:bureauCount) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MergeScoresToRecordBureauPull">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##otherwise##"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/bureau&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseEquifax&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseTransUnion&quot;/>&#xa;    &lt;xsl:template name=&quot;MergeScores-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:variable name=&quot;equifax&quot; select=&quot;$ParseEquifax/tns:score&quot;/>&#xa;        &lt;xsl:variable name=&quot;transUnion&quot; select=&quot;$ParseTransUnion/tns:score&quot;/>&#xa;        &lt;tns:BureauResult>&#xa;            &lt;xsl:if test=&quot;exists($equifax)&quot;>&#xa;                &lt;tns:equifaxScore>&#xa;                    &lt;xsl:value-of select=&quot;$equifax&quot;/>&#xa;                &lt;/tns:equifaxScore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($transUnion)&quot;>&#xa;                &lt;tns:transUnionScore>&#xa;                    &lt;xsl:value-of select=&quot;$transUnion&quot;/>&#xa;                &lt;/tns:transUnionScore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists(($equifax, $transUnion))&quot;>&#xa;                &lt;tns:selectedScore>&#xa;                    &lt;xsl:value-of select=&quot;max((xsd:integer($equifax), xsd:integer($transUnion)))&quot;/>&#xa;                &lt;/tns:selectedScore>&#xa;                &lt;tns:selectedBureau>&#xa;                    &lt;xsl:value-of select=&quot;if (empty($transUnion) or (exists($equifax) and xsd:integer($equifax) >= xsd:integer($transUnion))) then 'EQUIFAX' else 'TRANSUNION'&quot;/>&#xa;                &lt;/tns:selectedBureau>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:singleBureau>&#xa;                &lt;xsl:value-of select=&quot;count(($equifax, $transUnion)) = 1&quot;/>&#xa;            &lt;/tns:singleBureau>&#xa;            &lt;tns:bureauCount>&#xa;                &lt;xsl:value-of select=&quot;count(($equifax, $transUnion))&quot;/>&#xa;            &lt;/tns:bureauCount>&#xa;        &lt;/tns:BureauResult>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:ns0="http://xmlns.gmfin.example/credit/origination/bureau"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value inputQName="ns0:BureauResult"
                                        xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns10:BureauUnavailableFault"
                faultVariable="ThrowBureauUnavailable-input"
                name="ThrowBureauUnavailable"
                tibex:xpdlId="e86e3470-1729-55a1-b737-0bbd883c00cf">
                <tibex:inputBindings>
                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/bureau&quot; xmlns:tns1=&quot;http://xmlns.gmfin.example/credit/origination/faults&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ThrowBureauUnavailable-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:BureauUnavailableFault>&#xa;            &lt;tns1:applicationId>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:applicationId&quot;/>&#xa;            &lt;/tns1:applicationId>&#xa;            &lt;tns1:message>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Neither Equifax nor TransUnion returned a score&amp;quot;&quot;/>&#xa;            &lt;/tns1:message>&#xa;        &lt;/tns1:BureauUnavailableFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="MergeScoresToThrowBureauUnavailable"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="RecordBureauPull-input"
                    name="RecordBureauPull" outputVariable="RecordBureauPull"
                    tibex:xpdlId="567520f8-c238-56d8-b4f1-a846df00ec4d"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MergeScoresToRecordBureauPull"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecordBureauPullToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/bureau&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+567520f8-c238-56d8-b4f1-a846df00ec4d+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MergeScores&quot;/>&#xa;    &lt;xsl:template name=&quot;RecordBureauPull-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcUpdateActivityInput>&#xa;            &lt;applicationId>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:applicationId&quot;/>&#xa;            &lt;/applicationId>&#xa;            &lt;xsl:if test=&quot;$MergeScores/tns:equifaxScore&quot;>&#xa;                &lt;equifaxScore>&#xa;                    &lt;xsl:value-of select=&quot;$MergeScores/tns:equifaxScore&quot;/>&#xa;                &lt;/equifaxScore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$MergeScores/tns:transUnionScore&quot;>&#xa;                &lt;transUnionScore>&#xa;                    &lt;xsl:value-of select=&quot;$MergeScores/tns:transUnionScore&quot;/>&#xa;                &lt;/transUnionScore>&#xa;            &lt;/xsl:if>&#xa;            &lt;selectedScore>&#xa;                &lt;xsl:value-of select=&quot;$MergeScores/tns:selectedScore&quot;/>&#xa;            &lt;/selectedScore>&#xa;            &lt;singleBureau>&#xa;                &lt;xsl:value-of select=&quot;$MergeScores/tns:singleBureau&quot;/>&#xa;            &lt;/singleBureau>&#xa;        &lt;/tns6:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value sharedResourceProperty="jdbcProperty"
                                        sqlStatement="insert into gmf.bureau_pull&#xa;  (application_id, equifax_score, transunion_score, selected_score, single_bureau, pulled_at)&#xa;values (?, ?, ?, ?, ?, current_timestamp)"
                                        timeout="10"
                                        xsi:type="jdbcPalette:JDBCUpdateActivity">
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="applicationId"/>
                                        <PreparedParameters DataType="4"
                                            DataTypeDisplayValue="INTEGER"
                                            ParameterName="equifaxScore"/>
                                        <PreparedParameters DataType="4"
                                            DataTypeDisplayValue="INTEGER"
                                            ParameterName="transUnionScore"/>
                                        <PreparedParameters DataType="4"
                                            DataTypeDisplayValue="INTEGER"
                                            ParameterName="selectedScore"/>
                                        <PreparedParameters DataType="16"
                                            DataTypeDisplayValue="BOOLEAN"
                                            ParameterName="singleBureau"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input" name="End"
                    tibex:xpdlId="32f147e3-65ff-5e15-aedc-a582376c9d4f"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecordBureauPullToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/credit/origination/bureau&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MergeScores&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:BureauResult>&#xa;            &lt;xsl:if test=&quot;$MergeScores/tns:equifaxScore&quot;>&#xa;                &lt;tns:equifaxScore>&#xa;                    &lt;xsl:value-of select=&quot;$MergeScores/tns:equifaxScore&quot;/>&#xa;                &lt;/tns:equifaxScore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$MergeScores/tns:transUnionScore&quot;>&#xa;                &lt;tns:transUnionScore>&#xa;                    &lt;xsl:value-of select=&quot;$MergeScores/tns:transUnionScore&quot;/>&#xa;                &lt;/tns:transUnionScore>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:selectedScore>&#xa;                &lt;xsl:value-of select=&quot;$MergeScores/tns:selectedScore&quot;/>&#xa;            &lt;/tns:selectedScore>&#xa;            &lt;tns:selectedBureau>&#xa;                &lt;xsl:value-of select=&quot;$MergeScores/tns:selectedBureau&quot;/>&#xa;            &lt;/tns:selectedBureau>&#xa;            &lt;tns:singleBureau>&#xa;                &lt;xsl:value-of select=&quot;$MergeScores/tns:singleBureau&quot;/>&#xa;            &lt;/tns:singleBureau>&#xa;            &lt;tns:bureauCount>&#xa;                &lt;xsl:value-of select=&quot;$MergeScores/tns:bureauCount&quot;/>&#xa;            &lt;/tns:bureauCount>&#xa;        &lt;/tns:BureauResult>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
