    <tibex:ProcessInfo callable="true" createdBy="bwdev01"
        createdOn="Mon Mar 18 14:10:07 EDT 2019"
        description="Pulls Equifax and TransUnion in parallel and keeps the higher score."
        extraErrorVars="true" modifiers="public"
        productVersion="6.5.0 V63 2018-08-08" scalable="true" singleton="true"
        stateless="true" type="IT"/>
    <tibex:ProcessInterface context=""
        input="{http://xmlns.gmfin.example/credit/origination/bureau}BureauRequest"
        output="{http://xmlns.gmfin.example/credit/origination/bureau}BureauResult"/>
