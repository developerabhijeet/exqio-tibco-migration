    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        namespace="http://xmlns.gmfin.example/credit/origination/bureau"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        namespace="http://xmlns.gmfin.example/credit/origination/faults"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext" name="_processContext"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns0:BureauRequest" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:BureauResult" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="equifaxClient" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/bw/models/sharedresource/httpclient}HttpClientConfiguration"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>creditorigination.EquifaxClient</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="transUnionClient" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/bw/models/sharedresource/httpclient}HttpClientConfiguration"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>creditorigination.TransUnionClient</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource"
            type="xsd:string">
            <bpws:from>
                <bpws:literal>creditorigination.GMFOriginationDB</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns0:BureauScoreRequest"
            name="RenderBureauRequest-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ActivityOutputClass"
            name="RenderBureauRequest" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:RequestActivityInput"
            name="PullEquifax-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:RequestActivityOutput" name="PullEquifax"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns4:RequestActivityInput"
            name="PullTransUnion-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:RequestActivityOutput" name="PullTransUnion"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns6:ActivityInputClass"
            name="ParseEquifax-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:BureauScore" name="ParseEquifax"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns7:ActivityInputClass"
            name="ParseTransUnion-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:BureauScore" name="ParseTransUnion"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns0:BureauResult" name="MergeScores-input"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns0:BureauResult" name="MergeScores"
            sca-bpel:internal="true"/>
        <bpws:variable element="ns8:jdbcUpdateActivityInput"
            name="RecordBureauPull-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns9:jdbcUpdateActivityOutput"
            name="RecordBureauPull" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:BureauUnavailableFault"
            name="ThrowBureauUnavailable-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no"
            namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no"
            namespace="http://www.tibco.com/bw/process/info"/>
