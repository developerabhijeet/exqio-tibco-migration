    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="ReceiveFundingRequestToLookupDealer"
                    tibex:linkType="SUCCESS"/>
                <bpws:link name="LookupDealerToLookupDeal"
                    tibex:label="Dealer active"
                    tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LookupDealerToThrowDealerInactive"
                    tibex:label="" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LookupDealToCheckExistingFunding"
                    tibex:label="Within 2% of approved"
                    tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LookupDealToPublishFundingRejected"
                    tibex:label="" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckExistingFundingToInsertFunding"
                    tibex:label="Not yet funded"
                    tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckExistingFundingToLogDuplicateFunding"
                    tibex:label="" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="InsertFundingToPublishFundingEvent"
                    tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes" eventTimeout="60"
                    name="ReceiveFundingRequest"
                    tibex:xpdlId="c3bf7250-bbb1-5684-bd4f-219e7be8f53f"
                    variable="ReceiveFundingRequest"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="ReceiveFundingRequestToLookupDealer"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity activityTypeID="bw.jms.receive"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSReceiveMessage"/>
                                    <value acknowledgeMode="1"
                                        connectionReference="jmsConnection"
                                        destination="gmf.dealer.funding.request"
                                        messageSelector="MsgType = 'FUNDING_REQUEST'"
                                        messageType="XMLText"
                                        messagingStyle="Queue"
                                        pollingInterval="2"
                                        xsi:type="jms:JMSReceiveMessage">
                                        <bodyEditorElement href="platform:/resource/DealerFunding/Schemas/FundingRequest.xsd#//FundingRequest;XSDElementDeclaration"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LookupDealer-input"
                    name="LookupDealer" outputVariable="LookupDealer"
                    tibex:xpdlId="8682d7ee-6a89-5652-80d7-b974b025dc0a"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ReceiveFundingRequestToLookupDealer"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LookupDealerToLookupDeal">
                            <tibex:DesignExpression>
                                <tibex:expression expression="$LookupDealer/Record[1]/status = 'ACTIVE'"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$LookupDealer/Record[1]/status = 'ACTIVE']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LookupDealerToThrowDealerInactive">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##otherwise##"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8682d7ee-6a89-5652-80d7-b974b025dc0a+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;LookupDealer-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;dealerId>&#xa;                &lt;xsl:value-of select=&quot;concat(normalize-space($ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealerId), '%')&quot;/>&#xa;            &lt;/dealerId>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                        sharedResourceProperty="jdbcProperty"
                                        sqlStatement="select dealer_id, dealer_name, status&#xa;  from gmf.dealer&#xa; where dealer_id like ?"
                                        timeout="10"
                                        xsi:type="jdbcPalette:JDBCQueryActivity">
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="dealerId"/>
                                        <columnMetadata columnName="dealer_id"
                                            dataType="12"
                                            status="OptionalElement"
                                            typeName="varchar"/>
                                        <columnMetadata columnName="dealer_name"
                                            dataType="12"
                                            status="OptionalElement"
                                            typeName="varchar"/>
                                        <columnMetadata columnName="status"
                                            dataType="12"
                                            status="OptionalElement"
                                            typeName="varchar"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns12:DealerInactiveFault"
                faultVariable="ThrowDealerInactive-input"
                name="ThrowDealerInactive"
                tibex:xpdlId="18248c83-ea49-5bce-87c7-fe0fd0ca7db9">
                <tibex:inputBindings>
                    <tibex:partBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns2=&quot;http://xmlns.gmfin.example/dealer/funding/faults&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;LookupDealer&quot;/>&#xa;    &lt;xsl:template name=&quot;ThrowDealerInactive-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:DealerInactiveFault>&#xa;            &lt;tns2:dealerId>&#xa;                &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealerId&quot;/>&#xa;            &lt;/tns2:dealerId>&#xa;            &lt;xsl:if test=&quot;$LookupDealer/Record[1]/status&quot;>&#xa;                &lt;tns2:status>&#xa;                    &lt;xsl:value-of select=&quot;$LookupDealer/Record[1]/status&quot;/>&#xa;                &lt;/tns2:status>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:message>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Dealer is not active for funding&amp;quot;&quot;/>&#xa;            &lt;/tns2:message>&#xa;        &lt;/tns2:DealerInactiveFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LookupDealerToThrowDealerInactive"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LookupDeal-input"
                    name="LookupDeal" outputVariable="LookupDeal"
                    tibex:xpdlId="2958f7bc-39d5-5adb-b89c-319296c25c15"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LookupDealerToLookupDeal"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LookupDealToCheckExistingFunding">
                            <tibex:DesignExpression>
                                <tibex:expression expression="abs(number($ReceiveFundingRequest/Body/tns:FundingRequest/tns:fundingAmount) - number($LookupDeal/Record[1]/approved_amount)) &lt;= number($LookupDeal/Record[1]/approved_amount) * 0.02"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[abs(number($ReceiveFundingRequest/Body/tns:FundingRequest/tns:fundingAmount) - number($LookupDeal/Record[1]/approved_amount)) <= number($LookupDeal/Record[1]/approved_amount) * 0.02]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LookupDealToPublishFundingRejected">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##otherwise##"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2958f7bc-39d5-5adb-b89c-319296c25c15+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;LookupDeal-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;dealId>&#xa;                &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealId&quot;/>&#xa;            &lt;/dealId>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                        sharedResourceProperty="jdbcProperty"
                                        sqlStatement="select deal_id, dealer_id, approved_amount, status&#xa;  from gmf.deal&#xa; where deal_id = ?"
                                        timeout="10"
                                        xsi:type="jdbcPalette:JDBCQueryActivity">
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="dealId"/>
                                        <columnMetadata columnName="deal_id"
                                            dataType="12"
                                            status="OptionalElement"
                                            typeName="varchar"/>
                                        <columnMetadata columnName="dealer_id"
                                            dataType="12"
                                            status="OptionalElement"
                                            typeName="varchar"/>
                                        <columnMetadata columnName="approved_amount"
                                            dataType="2"
                                            status="OptionalElement"
                                            typeName="numeric"/>
                                        <columnMetadata columnName="status"
                                            dataType="12"
                                            status="OptionalElement"
                                            typeName="varchar"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="PublishFundingRejected-input"
                    name="PublishFundingRejected"
                    tibex:xpdlId="7898e7cc-b9be-5a21-84cc-72238ea1787c"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LookupDealToPublishFundingRejected"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns1=&quot;http://xmlns.gmfin.example/dealer/funding/event&quot; xmlns:tns8=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+7898e7cc-b9be-5a21-84cc-72238ea1787c+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;PublishFundingRejected-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:ActivityInput>&#xa;            &lt;Body>&#xa;                &lt;tns1:FundingEvent>&#xa;                    &lt;tns1:dealId>&#xa;                        &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealId&quot;/>&#xa;                    &lt;/tns1:dealId>&#xa;                    &lt;tns1:dealerId>&#xa;                        &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealerId&quot;/>&#xa;                    &lt;/tns1:dealerId>&#xa;                    &lt;tns1:amount>&#xa;                        &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:fundingAmount&quot;/>&#xa;                    &lt;/tns1:amount>&#xa;                    &lt;tns1:status>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REJECTED&amp;quot;&quot;/>&#xa;                    &lt;/tns1:status>&#xa;                    &lt;tns1:reason>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AMOUNT_OUTSIDE_TOLERANCE&amp;quot;&quot;/>&#xa;                    &lt;/tns1:reason>&#xa;                    &lt;tns1:eventTime>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:eventTime>&#xa;                &lt;/tns1:FundingEvent>&#xa;            &lt;/Body>&#xa;        &lt;/tns8:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jms.send"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSSendMessage"/>
                                    <value connectionReference="jmsConnection"
                                        deliveryMode="2"
                                        destination="gmf.funding.events"
                                        expiration="0" messageType="XMLText"
                                        messagingStyle="Topic" priority="4"
                                        xsi:type="jms:JMSSendMessage">
                                        <bodyEditorElement href="platform:/resource/DealerFunding/Schemas/FundingEvent.xsd#//FundingEvent;XSDElementDeclaration"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CheckExistingFunding-input"
                    name="CheckExistingFunding"
                    outputVariable="CheckExistingFunding"
                    tibex:xpdlId="0c87cecd-e8bb-586a-b334-bd7edb8c67e0"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LookupDealToCheckExistingFunding"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckExistingFundingToInsertFunding">
                            <tibex:DesignExpression>
                                <tibex:expression expression="count($CheckExistingFunding/Record) = 0"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CheckExistingFunding/Record) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckExistingFundingToLogDuplicateFunding">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##otherwise##"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0c87cecd-e8bb-586a-b334-bd7edb8c67e0+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckExistingFunding-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;dealId>&#xa;                &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealId&quot;/>&#xa;            &lt;/dealId>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                        sharedResourceProperty="jdbcProperty"
                                        sqlStatement="select funding_id, status&#xa;  from gmf.funding&#xa; where deal_id = ?"
                                        timeout="10"
                                        xsi:type="jdbcPalette:JDBCQueryActivity">
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="dealId"/>
                                        <columnMetadata columnName="funding_id"
                                            dataType="4"
                                            status="OptionalElement"
                                            typeName="int4"/>
                                        <columnMetadata columnName="status"
                                            dataType="12"
                                            status="OptionalElement"
                                            typeName="varchar"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogDuplicateFunding-input"
                    name="LogDuplicateFunding"
                    tibex:xpdlId="919de727-e1c4-53d5-8280-b2d84f4ba5eb"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckExistingFundingToLogDuplicateFunding"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns9=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDuplicateFunding-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DF-409&amp;quot;&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Deal ', $ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealId, ' already funded; request ignored')&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns9:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value controlBy="Application" role="Warn"
                                        suppressJobInfo="true"
                                        xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="InsertFunding-input"
                    name="InsertFunding" outputVariable="InsertFunding"
                    tibex:xpdlId="685fb02d-48d1-5e09-898e-e54a401e078e"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckExistingFundingToInsertFunding"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertFundingToPublishFundingEvent"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+685fb02d-48d1-5e09-898e-e54a401e078e+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertFunding-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcUpdateActivityInput>&#xa;            &lt;dealId>&#xa;                &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealId&quot;/>&#xa;            &lt;/dealId>&#xa;            &lt;dealerId>&#xa;                &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealerId&quot;/>&#xa;            &lt;/dealerId>&#xa;            &lt;amount>&#xa;                &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:fundingAmount&quot;/>&#xa;            &lt;/amount>&#xa;        &lt;/tns6:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value sharedResourceProperty="jdbcProperty"
                                        sqlStatement="insert into gmf.funding (deal_id, dealer_id, amount, status, funded_at)&#xa;values (?, ?, ?, 'FUNDED', current_timestamp)"
                                        timeout="10"
                                        xsi:type="jdbcPalette:JDBCUpdateActivity">
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="dealId"/>
                                        <PreparedParameters DataType="12"
                                            DataTypeDisplayValue="VARCHAR"
                                            ParameterName="dealerId"/>
                                        <PreparedParameters DataType="2"
                                            DataTypeDisplayValue="NUMERIC"
                                            ParameterName="amount"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="PublishFundingEvent-input"
                    name="PublishFundingEvent"
                    tibex:xpdlId="982b449f-8076-5238-b5c2-133b7888a53c"
                    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertFundingToPublishFundingEvent"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.gmfin.example/dealer/funding/request&quot; xmlns:tns1=&quot;http://xmlns.gmfin.example/dealer/funding/event&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+982b449f-8076-5238-b5c2-133b7888a53c+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveFundingRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;PublishFundingEvent-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:ActivityInput>&#xa;            &lt;Body>&#xa;                &lt;tns1:FundingEvent>&#xa;                    &lt;tns1:dealId>&#xa;                        &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealId&quot;/>&#xa;                    &lt;/tns1:dealId>&#xa;                    &lt;tns1:dealerId>&#xa;                        &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:dealerId&quot;/>&#xa;                    &lt;/tns1:dealerId>&#xa;                    &lt;tns1:amount>&#xa;                        &lt;xsl:value-of select=&quot;$ReceiveFundingRequest/Body/tns:FundingRequest/tns:fundingAmount&quot;/>&#xa;                    &lt;/tns1:amount>&#xa;                    &lt;tns1:status>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FUNDED&amp;quot;&quot;/>&#xa;                    &lt;/tns1:status>&#xa;                    &lt;tns1:eventTime>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:eventTime>&#xa;                &lt;/tns1:FundingEvent>&#xa;            &lt;/Body>&#xa;        &lt;/tns7:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jms.send"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config"
                                    xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSSendMessage"/>
                                    <value connectionReference="jmsConnection"
                                        deliveryMode="2"
                                        destination="gmf.funding.events"
                                        expiration="0" messageType="XMLText"
                                        messagingStyle="Topic" priority="4"
                                        xsi:type="jms:JMSSendMessage">
                                        <bodyEditorElement href="platform:/resource/DealerFunding/Schemas/FundingEvent.xsd#//FundingEvent;XSDElementDeclaration"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
