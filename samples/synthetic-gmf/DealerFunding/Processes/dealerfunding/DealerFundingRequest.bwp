        <bpws:variable element="ns8:jdbcUpdateActivityOutput"
            name="InsertFunding" sca-bpel:internal="true"/>
        <bpws:variable element="ns9:ActivityInput"
            name="PublishFundingEvent-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:ActivityInput"
