            <wsdl:portType name="funding"
                tibex:bw.rest.apipath="/funding/{dealId}"
                tibex:bw.rest.basepath="Funding"
                tibex:bw.rest.resource="Service Descriptors/dealerfunding.FundingStatusLookup-funding.json"
                tibex:bw.rest.resource.source="generated" tibex:source="bw.rest.service">
                <wsdl:documentation>Funding status for a dealer deal.</wsdl:documentation>
                <wsdl:operation name="get">
