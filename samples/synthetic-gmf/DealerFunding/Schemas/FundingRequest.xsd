<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:tns="http://xmlns.gmfin.example/dealer/funding/request" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://xmlns.gmfin.example/dealer/funding/request" version="1.0">
  <xs:annotation>
    <xs:documentation>Dealer funding request, JMS queue gmf.dealer.funding.request (XML text body).</xs:documentation>
  </xs:annotation>
  <xs:element name="FundingRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="dealId" type="xs:string"/>
        <xs:element name="dealerId" type="xs:string"/>
        <xs:element name="applicationId" type="xs:string"/>
        <xs:element name="fundingAmount" type="xs:decimal"/>
        <xs:element name="contractDate" type="xs:date"/>
        <xs:element minOccurs="0" name="requestedBy" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
